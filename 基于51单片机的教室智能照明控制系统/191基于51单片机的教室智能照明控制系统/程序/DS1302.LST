 209   1              Date_dispaly(0x80+8,time_data[2]);               //显示月
 210   1              Week_dispaly(0x80+0x40+15,time_data[1]); //显示周
 211   1              Date_dispaly(0x80+5,time_data[0]);               //显示年
 212   1                                                 //   Year/10*16+Year%10
 213   1              Hour=time_data[4]/16*10+time_data[4]%16;;
 214   1              Minute=time_data[5]/16*10+time_data[5]%16;;
 215   1              Second=time_data[6]/16*10+time_data[6]%16;;
 216   1      }
