 274          void set_rtc()                            //设置时间
 275          {
 276   1              uchar i,j;
 277   1              for(i=0;i<7;i++)                         //转换BCD码
 278   1              {
 279   2                      j=time_data[i]/10;
 280   2                      time_data[i]=time_data[i]%10;
 281   2                      time_data[i]=time_data[i]+j*16;
 282   2              }
 283   1              write_ds1302(0x8e,0x00);          //去除写保护
 284   1              for(i=0;i<7;i++)
 285   1              {
 286   2                      write_ds1302(write_add[i],time_data[i]);
 287   2              }
 288   1              write_ds1302(0x8e,0x80);      //加写保护
 289   1      }
 290          
 291          void read_rtc()
 292          {
 293   1              uchar i;
 294   1              for(i=0;i<7;i++)
 295   1              {
 296   2                      time_data[i]=read_ds1302(read_add[i]);  //最终读出来的数 16进制
 297   2              }
 298   1      }
