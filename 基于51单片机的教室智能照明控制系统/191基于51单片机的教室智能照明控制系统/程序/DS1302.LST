 133          void SetTime_dispaly(uchar add,uchar dat)        //第一个：参数的地址，第二个：参数的内容
 134          {
 135   1              uchar shi,ge;
 136   1              shi=dat/10;                                                     //把十位提取出来
 137   1              ge=dat%10;                                                      //把个位提取出来
 138   1              write_com(add);                                         //要写的地址
 139   1              write_date(0x30+shi);                           //十位的内容   1602字符库
 140   1              write_date(0x30+ge);                            //个位的内容   1602字符库
 141   1      }
 142          
 143          void Week_dispaly(uchar add,uchar dat)  //第一个：参数的地址，第二个：参数的内容
 144          {
 145   1              write_com(add);                                         //要写的地址
 146   1              write_date(0x30+dat);                           //十位的内容   1602字符库
 147   1      }
 148          void Date_dispaly(uchar add,uchar dat)   //第一个：参数的地址，第二个：参数的内容
 149          {
 150   1              uchar shi,ge;
 151   1              shi=dat/16;                                                     //把十位提取出来
 152   1              ge=dat%16;                                                      //把个位提取出来
 153   1              write_com(add+3);                                       //要写的地址
 154   1              write_date(0x30+shi);                           //十位的内容   1602字符库
 155   1              write_date(0x30+ge);                            //个位的内容   1602字符库                                  
 156   1      }
