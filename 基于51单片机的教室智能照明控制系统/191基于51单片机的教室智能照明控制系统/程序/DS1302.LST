1006          int readtemperature()                           //读整数部分
1007          {       
1008   1          int a,b;                                            //高八位，低八位
1009   1              ds18b20_init();
1010   1              write_byte(0xcc);                           //跳过rom匹配，跳过读序列号的操作，可节省操作时间
1011   1              write_byte(0x44);                           //启动温度检测
1012   1              delay(300);                                         //测温度
1013   1              ds18b20_init();                             //开始操作前需要复位
1014   1              write_byte(0xcc);                               //跳过rom匹配
1015   1              write_byte(0xbe);                           //写读寄存器中温度值的命令
1016   1              a=read_byte();                              //low         低位开始读取
1017   1              b=read_byte();                              //high        高位开始读取
1018   1              b<<=8;                                                  //把高位左移八位
1019   1              b=b|a;                                                  //高八位与第八位进行或运算，得到总和
1020   1              if(b>=0)                                                //如果温度大于等于0
1021   1              {
1022   2                      b=b*0.0625;                                     //直接乘以0.0625
1023   2                      write_com(0x80+0x40+2);         //在LCD1602对应的位置不写内容
1024   2                      write_date(0x20);
1025   2              }
1026   1          else                                                        //温度小于0
1027   1              {       
1028   2                      b=~b+1;                                         //取反码再加一
1029   2                      b=b*0.0625;                                     //再运算
1030   2                      write_com(0x80+0x40+2);         //在LCD1602对应的位置写一个负号
1031   2                      write_date(0x2d);
1032   2              }
1033   1              return b;                                               //返回b，此时以表示温度
1034   1      }
1035          void temperature_dispaly(char add,char dat)                     //温度显示函数：第一个：参数的地址，第二个：参数的内容
1036          {
1037   1              uchar shi,ge;
1038   1              shi=dat/10;                                                                             //把温度的十位提取出来
1039   1              ge=dat%10;                                                                              //把温度的个位提取出来
1040   1              write_com(0x80+0x40+add);                                               //要写的地址
1041   1              write_date(0x30+shi);                                                   //十位的内容   1602字符库
1042   1              write_date(0x30+ge);                                            //个位的内容    1602字符库
1043   1      }
1044          /*****************************************定时器初始化和主函数********************************************
             -***************/
C51 COMPILER V9.01   DS1302                                                                03/15/2017 19:49:58 PAGE 18  

1045          void T0_init(void)
1046          {
1047   1              TMOD=0x11;                                         //设置定时器0为工作方式1
1048   1              TH0=(65536-50000)/256;             //50MS定时
1049   1              TL0=(65536-50000)%256;
1050   1              EA=1;                                              //开定时器T0的中断   总中断
1051   1              ET0=1;                                             //允许T0中断
1052   1      //      TR0=1;                                             //开启定时器
1053   1      }
1054          void main()
1055          {
1056   1              AUTO_LED=0;                                      //默认自动模式
1057   1              temperature=readtemperature();
1058   1              init();                                          //液晶初始化
1059   1              T0_init();                                       //定时器初始化
1060   1              delay1(8000);
1061   1              while(1)
1062   1              {
1063   2                      if(Adjust==0)                    //非调节模式下显示时间人数和温度
1064   2                      {       
1065   3                              temperature=readtemperature();                  //读取温度
1066   3                              temperature_dispaly(3,temperature);             //显示温度
1067   3                              Time_Display();          //显示时间
1068   3                              Open();                          //动作判断,根据光线和声响开关
1069   3                              Count_Value();           //计算人数
1070   3                      }
1071   2                      Keyscan();                               //扫描键盘
1072   2              }
1073   1      }
1074          void Timer0() interrupt 1                                       //定时器T0中断函数
1075          {
1076   1              TH0=(65536-50000)/256;                                  //赋初值=50ms
1077   1              TL0=(65536-50000)%256;                                  //TH0=3C,TL0=B0
1078   1              Count++;                                                                //每中断一次，Count加一，计数20次，表示1s的时间到
1079   1              if(Count>=20)                                                   //1s到
1080   1              {
1081   2                      Count=0;
1082   2                      Miao++;
1083   2                      if(Miao>=3)                                                     //3秒内无触发另一个，全部清零
1084   2                      {
1085   3                              Miao=0;
1086   3                              OUT1_flag=0;                                    //清零
1087   3                              IN1_flag=0;
1088   3                              TR0=0;                                                  //关闭定时器
1089   3                      }
1090   2              }
1091   1      
1092   1      }


