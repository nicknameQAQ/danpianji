 993          void ds18b20_init()                                 //初始化函数
 994          {
 995   1              uint n;
 996   1              DQ=1;
 997   1              delay(8);                                          
 998   1              DQ=0;
 999   1              delay(80);                                          //低电平480——960us
1000   1              DQ=1;                                                   //总线释放
1001   1              delay(8);                                           //等待50——100us
1002   1              n=DQ;                                               //读取复位状态
1003   1              delay(4);
1004   1      }
