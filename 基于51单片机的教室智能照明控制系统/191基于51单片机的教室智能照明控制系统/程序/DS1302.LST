 181          void LCD_Display_String(unsigned char line,unsigned char *string)
 182          {                                                                               //液晶屏显示内容，把要显示的内容写到对应的位置
 183   1              unsigned char i;
 184   1              unsigned char address=0;
 185   1              if(line==1)
 186   1              {
 187   2                      address=0x80;                                   //0X80是第1行的第1个位置  ,0x81第2位
 188   2              }
 189   1              else if(line==2)
 190   1              {
 191   2                      address=0x80+0x40;                      //0X80+0x40是第2行的第1个位置  ,0X80+0x40+1是第2行第2位
 192   2              }
 193   1              
 194   1              for(i=0;i<16;i++)
 195   1              {
 196   2                      write_com(address);
 197   2                      write_date(string[i]);
 198   2                      address++;
 199   2              } 
 200   1      }
