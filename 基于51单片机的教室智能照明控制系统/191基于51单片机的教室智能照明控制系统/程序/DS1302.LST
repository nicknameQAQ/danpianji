 202          void Time_Display(void)
 203          {
 204   1              read_rtc();
 205   1              Date_dispaly(0x80+0x40+9,time_data[6]);  //显示秒
 206   1              Date_dispaly(0x80+0x40+6,time_data[5]);  //显示分
 207   1              Date_dispaly(0x80+0x40+3,time_data[4]);  //显示时
