 963          void write_byte(uint dat)                       //写一个字节
 964          {
 965   1              uchar i;
 966   1              for(i=0;i<8;i++)                        //循环八次        共有八位
 967   1              {
 968   2                      DQ=0;                                           //写零
 969   2                      DQ=dat&0x01;                //向总线写位数据，从最低位写起
 970   2                      delay(4);
 971   2                      DQ=1;                                           //写一
 972   2                      dat>>=1;                                    //下次写作准备，移位数据
 973   2              }
 974   1              delay(4);
 975   1      }                                    
 976          
 977          uchar read_byte(void)                           //读一个字节，返回值
 978          {
 979   1              uchar i;
 980   1              uint value;
 981   1              for(i=0;i<8;i++)                        //循环八次        共有八位
 982   1              {
 983   2                      DQ=0;
C51 COMPILER V9.01   DS1302                                                                03/15/2017 19:49:58 PAGE 17  

 984   2                      value>>=1;
 985   2                      DQ=1;                                           //释放总线
 986   2                      if(DQ)
 987   2                      value|=0x80;                        //DQ=1，value取1
 988   2                      delay(4);
 989   2              }
 990   1              return value;
 991   1      }
