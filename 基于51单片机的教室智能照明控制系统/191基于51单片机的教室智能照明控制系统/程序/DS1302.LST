 218          
 219          void write_ds1302_byte(uchar dat)
 220          {
 221   1              uchar i;
 222   1              for(i=0;i<8;i++)
 223   1              {
 224   2                      sck=0;
 225   2                      io=dat&0x01;                                       //准备数据,从最低位开始
 226   2                      dat=dat>>1;
 227   2                      sck=1;
 228   2              }
 229   1      }
 230          
 231          void write_ds1302(uchar add,uchar dat)
 232          {
 233   1              rst=0;
 234   1              _nop_();                                                //CPU原地踏步
 235   1              sck=0;
 236   1              _nop_();
 237   1              rst=1;
 238   1              _nop_();
 239   1              write_ds1302_byte(add);             //传地址
 240   1              write_ds1302_byte(dat);             //传数据
C51 COMPILER V9.01   DS1302                                                                03/15/2017 19:49:58 PAGE 5   

 241   1              rst=0;                                                  //不受其他影响
 242   1              _nop_();
 243   1              io=1;                                              //释放
 244   1              sck=1;
 245   1      }
 246          
 247          uchar read_ds1302(uchar add)
 248          {
 249   1              uchar i,value;
 250   1              rst=0;
 251   1              _nop_();  //CPU原地踏步
 252   1              sck=0;
 253   1              _nop_();
 254   1              rst=1;
 255   1              _nop_();
 256   1              write_ds1302_byte(add);
 257   1              for(i=0;i<8;i++)
 258   1              {
 259   2                      value=value>>1;
 260   2                      sck=0;
 261   2                      if(io)
 262   2                      value=value|0x80;
 263   2                      sck=1;
 264   2              }
 265   1              rst=0;
 266   1              _nop_();
 267   1              sck=0;
 268   1              _nop_();
 269   1              sck=1;
 270   1              io=1;
 271   1              return value;
 272   1      }
