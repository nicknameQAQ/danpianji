 202          void  time1_int(void) interrupt 1//定时器工作函数
 203          {
 204   1              uchar count;                             //定义变量用于定时      
 205   1              TL0=0xb0;
 206   1              TH0=0x3c;                                        //定时器重新赋初值50ms
 207   1              count++;                                         //变量50ms加一次
 208   1              if(count==10)                            //加10次就是500ms
 209   1              {
 210   2                      count=0;                                 //变量清零
 211   2                      if(flag2==0)                     //报警关
 212   2                              LED_Y=1;                         //报警指示灯熄灭
 213   2                      else                                     //报警开
 214   2                              LED_Y=0;                         //对应的报警指示灯点亮
 215   2                      if(flag7==0)
 216   2                              LED_R=1;
 217   2                      else 
 218   2                              LED_R=0;
 219   2                      if(flag2==1||flag7==1)   //有报警
 220   2                      {
 221   3                              FENG=!FENG;                      //蜂鸣器闪烁报警
 222   3                              san=0;                           //打开继电器启动风扇
 223   3                      }
 224   2                      if(flag2==0&&flag7==0)   //都没有报警
 225   2                      {
 226   3                              FENG=1;                          //关闭蜂鸣器
 227   3                              san=1;                           //关闭风扇
 228   3                      }
 229   2              }
 230   1      } 


