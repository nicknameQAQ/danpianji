  89          //ADC0809读取信息
  90          uchar ADC0809()
  91          {
  92   1              uchar temp_=0x00;
  93   1              OE=0;   //初始化高阻太
  94   1              ST=0;   //转化初始化
  95   1              ST=1;   //开始转换
  96   1              ST=0;
  97   1              while(EOC==0)   //外部中断等待AD转换结束
  98   1              OE=1;      //读取转换的AD值
