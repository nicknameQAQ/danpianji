 106          /***************DS1302有关子函数********************/
 107          void write_byte(uchar dat)//写一个字节
 108          {
 109   1              ACC=dat;
 110   1              RST=1;
 111   1              for(a=8;a>0;a--)
 112   1              {
 113   2                      IO=ACC0;
 114   2                      SCLK=0;
 115   2                      SCLK=1;
 116   2                      ACC=ACC>>1;
 117   2              }
C51 COMPILER V9.00   001                                                                   11/25/2016 22:47:16 PAGE 3   

 118   1      }
 119          uchar read_byte()//读一个字节
 120          {
 121   1              RST=1;
 122   1              for(a=8;a>0;a--)
 123   1              {
 124   2                      ACC7=IO;
 125   2                      SCLK=1;
 126   2                      SCLK=0;
 127   2                      ACC=ACC>>1;
 128   2              }
 129   1              return(ACC);
 130   1      }
 131          //----------------------------------------
 132          void write_1302(uchar add,uchar dat)//向1302芯片写函数，指定写入地址，数据
 133          {
 134   1              RST=0;
 135   1              SCLK=0;
 136   1              RST=1;
 137   1              write_byte(add);
 138   1              write_byte(dat);
 139   1              SCLK=1;
 140   1              RST=0;
 141   1      }
 142          uchar read_1302(uchar add)//从1302读数据函数，指定读取数据来源地址
 143          {
 144   1              uchar temp;
 145   1              RST=0;
 146   1              SCLK=0;
 147   1              RST=1;
 148   1              write_byte(add);
 149   1              temp=read_byte();
 150   1              SCLK=1;
 151   1              RST=0;
 152   1              return(temp);
 153   1      }
 154          uchar BCD_Decimal(uchar bcd)//BCD码转十进制函数，输入BCD，返回十进制
 155          {
 156   1              uchar Decimal;
 157   1              Decimal=bcd>>4;
 158   1              return(Decimal=Decimal*10+(bcd&=0x0F));
 159   1      }
