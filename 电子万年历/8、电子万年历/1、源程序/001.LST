 617          //定时器0初始化程序
 618          void init() //定时器、计数器设置函数
 619          {
 620   1              TMOD=0x11; //指定定时/计数器的工作方式为1
 621   1              TH0=0;  //定时器T0的高四位=0
 622   1              TL0=0;  //定时器T0的低四位=0
 623   1              EA=1;  //系统允许有开放的中断
 624   1              ET0=1; //允许T0中断
 625   1              TR0=1; //开启中断，启动定时器
 626   1      }
 627          //*******************主函数**************************
 628          //***************************************************
 629          void main()
 630          {       
 631   1              lcd_init();      //调用液晶屏初始化子函数
 632   1              ds1302_init();   //调用DS1302时钟的初始化子函数
 633   1              init();          //调用定时计数器的设置子函数
 634   1              led=0;           //打开LCD的背光电源
 635   1          buzzer=0;//蜂鸣器长响一次
 636   1          delay(80);
 637   1          buzzer=1; 
 638   1              while(1)  //无限循环下面的语句：
 639   1              {               
 640   2              keyscan();      //调用键盘扫描子函数
 641   2          }
 642   1      }
 643          /*************通过定时中断实现定是独处并显示数据******************/
 644          void t0() interrupt 1  //取得并显示日历和时间
 645          {       
 646   1              //Init_DS18B20();//温度传感器DS18b2初始化子函数，在头文件中
 647   1              flag=ReadTemperature();//将18b2头文件运行返回的函数结果送到变量FLAG中，用于显示
 648   1              //读取秒时分周日月年七个数据（DS1302的读寄存器与写寄存器不一样）：
 649   1              miao=BCD_Decimal(read_1302(0x81));
 650   1              fen=BCD_Decimal(read_1302(0x83));
 651   1              shi=BCD_Decimal(read_1302(0x85));
 652   1              ri=BCD_Decimal(read_1302(0x87));
 653   1              yue=BCD_Decimal(read_1302(0x89));
 654   1              nian=BCD_Decimal(read_1302(0x8d));
 655   1              week=BCD_Decimal(read_1302(0x8b));
 656   1              //显示温度、秒、时、分数据：
 657   1              write_temp(12,flag);//显示温度，从第二行第12个字符后开始显示
 658   1              write_sfm(8,miao);//秒，从第二行第8个字后开始显示（调用时分秒显示子函数）
 659   1              write_sfm(5,fen);//分，从第二行第5个字符后开始显示
 660   1              write_sfm(2,shi);//小时，从第二行第2个字符后开始显示
 661   1              //显示日、月、年数据：
 662   1              write_nyr(9,ri);//日期，从第二行第9个字符后开始显示
 663   1              write_nyr(6,yue);//月份，从第二行第6个字符后开始显示
 664   1              write_nyr(3,nian);//年，从第二行第3个字符后开始显示
 665   1              write_week(week-1);
 666   1              /***********整点报时程序************/
 667   1              if(fen==0&&miao==0)
 668   1                      if(shi<22&&shi>6 )
 669   1                      {
 670   2                              buzzer=0;//蜂鸣器短响一次
 671   2                              delay(20);
 672   2                              buzzer=1;
 673   2                      }
 674   1                      /**************闹钟程序: 将暂停键按下停止蜂鸣********************/
 675   1                      if(shi1==shi&&fen1==fen&&miao==0)
C51 COMPILER V9.00   001                                                                   11/25/2016 22:47:16 PAGE 12  

 676   1                      {               
 677   2                              clock=1; 
 678   2                      }       
 679   1                      if(clock==1)
 680   1                      {
 681   2                              buzzer=0;//蜂鸣器短响一次
 682   2                              delay(20);
 683   2                              buzzer=1;
 684   2                      }
 685   1                      if(CLO==0)      /*按下p1.4停止蜂鸣*/
 686   1                              clock=0;        
 687   1      }
