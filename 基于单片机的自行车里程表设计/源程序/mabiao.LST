 575          void time0() interrupt 1
 576          {
 577   1              uchar m,n;
 578   1              TH0=0x3c;
 579   1              TL0=0xb0;        //50ms
 580   1              m++;
 581   1              if(LED_SEC==1)
 582   1              {
 583   2                      n++;
 584   2                      if(n>=10)
 585   2                      {
 586   3                              n=0;
 587   3                              LED_SEC=0;
 588   3                      }
 589   2              }
 590   1              
 591   1              if(m>=10)
 592   1              {
 593   2                      m=0;
 594   2                      Mileage=Mileage+10*(Velocity/3.6)/2;             //里程m=里程+速度km/h/3.6/2
 595   2                      Velocity=count *2*3.14*RADIUS /100000*2*3600  /40;//将500ms的距离经过运算得到km/h，将速度/100，方便显示
 596   2                      count=0;        
 597   2              }
 598   1      }
