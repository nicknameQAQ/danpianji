   1          //用BCD码设计0-255
   2          #include<reg52.h>
   3          #define uchar unsigned char 
   4          #define uint unsigned int 
   5          #define T 100   
   6          sbit RES=P3^7;  
   7          int S=0,M=30;
   8          uchar count=0,ct=0;
   9          
  10          uchar tab_d[10]={0X3F,0X06,0X5B,0X4F,0X66,       //段码
  11          0X6D,0X7D,0X07,0X7F,0X6F};
  12          uchar tab_wei[8]={0xfe,0xfd,0xfb,0xf7,           //位码
  13          0xef,0xdf,0xbf,0x7f};
  14          
  15          //延时函数
  16          void delay(uint t)  // tms
  17          {
  18   1              uchar i=0;
  19   1              while(t--)
  20   1              for(i;i<120;i++);
  21   1      }
  22          
  23          //数码管显示函数
  24          void disp(uchar d,uchar x,uchar w)      //d为段选，x为小数点，w为位选
  25          {
  26   1              P2=0xff;        //位码选择       只能先设置位码再设置段码
  27   1              P2=tab_wei[w];          
  28   1              P0=0;
  29   1              P0=tab_d[d]|x;           // 加上小数点  
  30   1              delay(T);                       
  31   1      }
  32          
  33          //计数函数
  34          void timer()
  35          {       
  36   1              disp(M%10,0,0);                         //   角                                 
  37   1              disp(M/10%10,0x80,1);           //       元               0x80表示加上小数点
  38   1              if(M>=100)
  39   1              disp(M/100%10,0,2);                     //      十元
  40   1              if(M>=1000)
  41   1              disp(M/1000%10,0,3);            //      百元
  42   1              disp(S%10,0,4);                 //        公里          
  43   1              disp(S/10%10,0x80,5);
  44   1              if(S>=100)
  45   1              disp(S/100%10,0,6);
  46   1              if(S>=1000)
  47   1              disp(S/1000%10,0,7);              
  48   1      }
  49          
  50          //定时器0中断
  51          void time_50ms() interrupt 1    
  52          {
  53   1              TH0=255;
  54   1              TL0=255;
  55   1              ct++;
