  13          void ADCinit(void)
  14          {
  15   1              //unsigned int i;
  16   1              AUXR1=0x00;                                             //8位结果
  17   1              P1ASF=0x02;                                             //P1ASF=0x02;设置P1.1作为模拟口，AD输入
  18   1              ADC_RES=0;                                              //AD结果寄存器清0
  19   1              ADC_CONTR=0x80;                                 //开启AD电源
  20   1              //for(i=2000;i>0;i--);                  //开启AD电源延时等待电压稳定
  21   1      }
  22          unsigned char getADC(unsigned char ch)
  23          {
  24   1              ADC_CONTR=0xe8|ch;                              //开启AD中断，最高速度 ADC_CONTR=0xe8|ch;
  25   1              _nop_();
  26   1              _nop_();
  27   1              _nop_();
  28   1              _nop_();
  29   1              while(!(ADC_CONTR&0x10));
  30   1              ADC_CONTR&=~0x10;
  31   1              return ADC_RES;
  32   1      }
