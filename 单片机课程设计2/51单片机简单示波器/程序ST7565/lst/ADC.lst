  41   1              TH0=samptime>>8;
  42   1              TL0=samptime&0xff;
  43   1              TH1=0x3c;                                               //T1测频率，计数50000进一次中断
  44   1              TL1=0xb0;
  45   1              TR0=0;
  46   1              ET0=0;
  47   1              TR1=1;
  48   1              ET1=1;
  49   1              EA =1;
