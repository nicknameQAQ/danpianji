  59          void init()     //初始化函数 
  60          {
  61   1              TH0=0x3C;
  62   1              TL0=0xB0;  //赋初值50ms（12MHz晶振）
  63   1              TMOD=0x01; //定义工作方式
  64   1              EA=1;      //打开中断总开关
  65   1              ET0=1;     //打开中断允许开关
  66   1              TR0=0;     //关闭定时器定时开关 
  67   1              bufang=0;
  68   1              SOS=0;
  69   1              chefang=0;      //按键初始化 
  70   1      }
  71          
  72          void main()     //主函数
  73          {
  74   1              init(); //调用初始化 
  75   1              while(1)//循环
  76   1              {
  77   2                      kongzhi();//控制函数 
  78   2              }
  79   1      }
  80          
  81          void time() interrupt 1//定时器函数 
  82          {
  83   1              TH0=0x3C;
  84   1              TL0=0xB0;               //重新赋初值 
  85   1              t++;
  86   1              if(t==20)               //t加一次时50ms，加20次时1s
  87   1              {
  88   2                      t=0;            //t清零
  89   2                      t1++;           //t1加一次时1s
  90   2                      if(t1==30)//计时到30s时开启布防数码管停止显示  关闭定时器   
  91   2                      {
  92   3                              t1=0;   //t1清零
  93   3                              flag=1; //布防标志位，=1时进入布防状态
  94   3                              P2=0xff;//数码管关闭显示
  95   3                              TR0=0;  //停止计时
  96   3                      }
  97   2              }
  98   1              if((t>=10)&&(flag1==1))//报警 t每加到10（500ms）蜂鸣器引脚取反一次
  99   1              {
 100   2                      baojing=~baojing;  //闪烁鸣响
 101   2                      t=0;                       //t清零
 102   2              }
 103   1      }
