   1          //包含头文件
   2          #include <reg51.h>
   3          //宏定义
   4          #define uc unsigned char
   5          #define ui unsigned int
   6          
   7          sbit SOS        =       P1^0;//报警按键 连接热释电模块
   8          sbit bufang     =       P1^1;//布防
   9          sbit chefang=   P1^2;//撤防
  10          sbit baojing=   P1^3;//蜂鸣器
  11          
  12          bit bdata flag,flag1;//flag布防标志，flag1布防倒计时标志 
  13          uc t,t1;                        //定时器专用变量 
  14          
  15          void delay(ui x)        //延时函数 大约延时x ms （不精确） 
  16          {
  17   1              ui i,j;
  18   1              for(i=0;i<x;i++)
  19   1              for(j=0;j<110;j++);
  20   1      }
  21                  
  22          void kongzhi()          //控制函数 
  23          {
  24   1              if((bufang==1)&&(flag==0))      //在待机时按下布防键 
  25   1              {
  26   2                      delay(10);                              //延时去抖
  27   2                      if((bufang==1)&&(flag==0))//再次判断按键是否按下
  28   2                      {
  29   3                              t=0;                    //清零计时器
  30   3                              t1=0;                   //清零计时器 
  31   3                              TR0=1;                  //打开计时器 
  32   3                              P2=0x85;                //显示字母b 
  33   3                      }
  34   2              }
  35   1              if((flag==1)&&(SOS==1)) //进入布防状态后报警按键按下（或者热释电模块有信号发出）
  36   1              {
  37   2                      flag1=1;                        //蜂鸣器鸣响 
  38   2                      P2=0xbf;                        //显示"-"
  39   2                      TR0=1;                          //开启定时器 
  40   2              }
  41   1              if(chefang==1)                  //撤防键按下 
  42   1              {
  43   2                      delay(10);
  44   2                      if(chefang==1)
  45   2                      {
  46   3                              {
  47   4                                      flag1=0;        //关闭布防计时
  48   4                                      baojing=1;      //关闭蜂鸣器 
  49   4                                      flag=0;         //停止计时器计时
  50   4                                      TR0=0;          //关闭计时器 
  51   4                                      P2=0xa7;        //显示字母c 
  52   4                                      delay(1000);//延时1s 
  53   4                                      P2=0xff;        //关闭显示，进入等待布防状态  
  54   4                              }
  55   3                      }
