 155          uchar TLC549_ADC(void)
 156          {
 157   1                 uchar n, tmp;
 158   1      
 159   1              CS  = 1;                     //CS置高,片选无效
 160   1              CLK = 0;
 161   1      
 162   1              CS  = 0;                     //CS置低,片选有效,同时DO输出高位
 163   1              _nop_();
 164   1              _nop_();                     //适当延迟时间1.4us Setup Time
 165   1      
 166   1              for(n = 0; n < 8; n++) //串行数据移位输入
 167   1              { 
 168   2                      tmp <<= 1;
 169   2                      tmp |=  DI;
 170   2      
 171   2                      CLK = 1;        //0.4us
 172   2                      _nop_();        //延迟0.1us
 173   2                      CLK = 0;        //0.4us
 174   2              }
