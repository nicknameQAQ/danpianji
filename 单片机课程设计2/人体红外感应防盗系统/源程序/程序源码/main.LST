 220          void Uart() interrupt 4 using 1
 221          {
 222   1          if (RI)
 223   1          {
 224   2              RI = 0;                 //清除RI位
 225   2              P0 = SBUF;              //P0显示串口数据
 226   2              P22 = RB8;              //P2.2显示校验位
 227   2          }
 228   1          if (TI)
 229   1          {
 230   2              TI = 0;                 //清除TI位
 231   2              busy = 0;               //清忙标志
 232   2          }
 233   1      }
