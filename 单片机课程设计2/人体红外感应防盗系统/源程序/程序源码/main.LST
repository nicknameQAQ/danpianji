 238          void SendData(BYTE dat)
 239          {
 240   1          while (busy);               //等待前面的数据发送完成
 241   1          ACC = dat;                  //获取校验位P (PSW.0)
C51 COMPILER V9.00   MAIN                                                                  06/03/2018 17:55:24 PAGE 5   

 242   1          if (P)                      //根据P来设置校验位
 243   1          {
 244   2      #if (PARITYBIT == ODD_PARITY)
                      TB8 = 0;                //设置校验位为0
              #elif (PARITYBIT == EVEN_PARITY)
                      TB8 = 1;                //设置校验位为1
              #endif
 249   2          }
 250   1          else
 251   1          {
 252   2      #if (PARITYBIT == ODD_PARITY)
                      TB8 = 1;                //设置校验位为1
              #elif (PARITYBIT == EVEN_PARITY)
                      TB8 = 0;                //设置校验位为0
              #endif
 257   2          }
 258   1          busy = 1;
 259   1          SBUF = ACC;                 //写数据到UART数据寄存器
 260   1      }
