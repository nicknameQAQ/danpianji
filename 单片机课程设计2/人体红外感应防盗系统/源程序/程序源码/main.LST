 451          void  ADC_config(void)
 452          {
 453   1        ADC_InitTypeDef   ADC_InitStructure;        //结构定义
 454   1        ADC_InitStructure.ADC_Px        = ADC_P10;  //设置要做ADC的IO,  ADC_P10 ~ ADC_P17(或操作),ADC_P1_All
