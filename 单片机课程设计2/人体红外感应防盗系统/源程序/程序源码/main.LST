 456   1        ADC_InitStructure.ADC_Power     = ENABLE;     //ADC功率允许/关闭  ENABLE,DISABLE
 457   1        ADC_InitStructure.ADC_AdjResult = ADC_RES_H8L2;   //ADC结果调整,  ADC_RES_H2L8,ADC_RES_H8L2
 458   1        ADC_InitStructure.ADC_Polity    = PolityLow;    //优先级设置  PolityHigh,PolityLow
 459   1        ADC_InitStructure.ADC_Interrupt = DISABLE;      //中断允许    ENABLE,DISABLE
 460   1        ADC_Inilize(&ADC_InitStructure);          //初始化
 461   1        ADC_PowerControl(ENABLE);             //单独的ADC电源操作函数, ENABLE或DISABLE
 462   1      }
