   3          /*******************************************************************************
   4          * 函 数 名         : Lcd1602_Delay1ms
   5          * 函数功能       : 延时函数，延时1ms
   6          * 输    入         : c
   7          * 输    出         : 无
   8          * 说    名         : 该函数是在12MHZ晶振下，12分频单片机的延时。
   9          *******************************************************************************/
  10          
  11          void Lcd1602_Delay1ms(uint c)   //误差 0us
  12          {
  13   1      
  14   1        
  15   1             unsigned int i;
  16   1         do{
  17   2              i = MAIN_Fosc / 13000;
  18   2            while(--i)  ;   //14T per loop
  19   2           }while(--c);
  20   1            
  21   1      }
  22          
  23          /*******************************************************************************
  24          * 函 数 名         : LcdWriteCom
  25          * 函数功能       : 向LCD写入一个字节的命令
  26          * 输    入         : com
  27          * 输    出         : 无
  28          *******************************************************************************/
  29          
  30          void LcdWriteCom(uchar com)   //写入命令
  31          {
  32   1        LCD1602_E = 0;   //使能清零
  33   1        LCD1602_RS = 0;  //选择写入命令
  34   1        LCD1602_RW = 0;  //选择写入
  35   1      
  36   1        LCD1602_DATAPINS = com; //由于4位的接线是接到P0口的高四位，所以传送高四位不用改
  37   1        Lcd1602_Delay1ms(1);
  38   1      
  39   1        LCD1602_E = 1;   //写入时序
  40   1        Lcd1602_Delay1ms(5);
  41   1        LCD1602_E = 0;
  42   1      
  43   1      //  Lcd1602_Delay1ms(1);
  44   1        LCD1602_DATAPINS = com << 4; //发送低四位
  45   1        Lcd1602_Delay1ms(1);
  46   1      
  47   1        LCD1602_E = 1;   //写入时序
  48   1        Lcd1602_Delay1ms(5);
  49   1        LCD1602_E = 0;
  50   1      }
  51          
  52          /*******************************************************************************
  53          * 函 数 名         : LcdWriteData
  54          * 函数功能       : 向LCD写入一个字节的数据
  55          * 输    入         : dat
C51 COMPILER V9.00   LCD                                                                   06/03/2018 17:55:24 PAGE 2   

  56          * 输    出         : 无
  57          *******************************************************************************/       
  58          
  59          void LcdWriteData(uchar dat)      //写入数据
  60          {
  61   1        LCD1602_E = 0;    //使能清零
  62   1        LCD1602_RS = 1;   //选择写入数据
  63   1        LCD1602_RW = 0;   //选择写入
  64   1      
  65   1        LCD1602_DATAPINS = dat; //由于4位的接线是接到P0口的高四位，所以传送高四位不用改
  66   1        Lcd1602_Delay1ms(1);
  67   1      
  68   1        LCD1602_E = 1;    //写入时序
  69   1        Lcd1602_Delay1ms(5);
  70   1        LCD1602_E = 0;
  71   1      
  72   1        LCD1602_DATAPINS = dat << 4; //写入低四位
  73   1        Lcd1602_Delay1ms(1);
  74   1      
  75   1        LCD1602_E = 1;    //写入时序
  76   1        Lcd1602_Delay1ms(5);
  77   1        LCD1602_E = 0;
  78   1      }
  79          
  80          /*******************************************************************************
  81          * 函 数 名       : LcdInit()
  82          * 函数功能     : 初始化LCD屏
  83          * 输    入       : 无
  84          * 输    出       : 无
  85          *******************************************************************************/       
  86          
  87          void LcdInit()              //LCD初始化子程序
  88          {
  89   1        LcdWriteCom(0x32);   //将8位总线转为4位总线
  90   1        LcdWriteCom(0x28);   //在四位线下的初始化
  91   1        LcdWriteCom(0x0c);  //开显示不显示光标
  92   1        LcdWriteCom(0x06);  //写一个指针加1
  93   1        LcdWriteCom(0x01);  //清屏
  94   1        LcdWriteCom(0x80);  //设置数据指针起点
  95   1      }
