 141          /*************定时器0中断服务程序***************/
 142          void time0_int() interrupt 1
 143          {       
 144   1              static uint value;
 145   1              TH0 = 0x3c;
 146   1              TL0 = 0xb0;     // 50ms   
 147   1              value ++;
 148   1              if(value % 6 == 0)
 149   1              {
 150   2                      flag_300ms = 1;
 151   2              }
 152   1              if(flag_bufang_en == 1)
 153   1              {
 154   2                      flag_value ++;
 155   2                      if(flag_value >= 600)  //30秒
 156   2                      {
 157   3                              flag_bufang = 1;
 158   3                              flag_bufang_en = 0;
 159   3                              flag_value = 0; 
 160   3                      }
 161   2              }
 162   1      }


