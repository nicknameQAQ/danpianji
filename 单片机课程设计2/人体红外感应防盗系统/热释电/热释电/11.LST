  58          /*************定时器0初始化程序***************/
  59          void time_init()          
  60          {
  61   1              EA   = 1;                 //开总中断
  62   1              TMOD = 0X01;      //定时器0工作方式1
  63   1              ET0  = 1;                 //开定时器0中断 
  64   1              TR0  = 1;                 //允许定时器0定时
  65   1      }
  66          
  67          uchar flag_alarm ;     //报警标志位
  68          uchar flag_bufang ;    //布防标志位
  69          uchar flag_bufang_en ; //布防标志位使能
  70          uint  flag_value;      //用做定时器的变量
  71          
  72          /******************红外报警处理**********************/     
  73          void hongwai_dis()
  74          {
  75   1              if(flag_alarm == 1)        //报警
  76   1              {
  77   2                      red = ~red;                //红灯报警
  78   2                      beep = ~beep;      //蜂鸣器报警
  79   2              }       
  80   1              if(flag_bufang_en == 1) //准备开始布防
  81   1              {
  82   2                      green = ~green;    //绿灯闪
  83   2                              
  84   2              }  
  85   1              if(flag_bufang == 1)   //确认布防
  86   1              {
  87   2                      green = 0;         //如果延时布防成功 绿灯长亮
  88   2                      if(hw == 1)            //红外有输出
  89   2                      {
  90   3                              flag_alarm = 1; 
  91   3                      }
  92   2              }
  93   1      
  94   1      }
  95          
  96          /******************对应不同按键处理**********************/         
  97          void key_with()
  98          {
  99   1              if(key_can == 1)         //按键紧急报警
 100   1              {
 101   2                      flag_alarm = 1;  //报警标志位 ;                 
 102   2              }
 103   1              if(key_can == 2)     //布防按键
 104   1              {
 105   2                      flag_bufang_en = 1;             
 106   2              }
 107   1              if(key_can == 3)         //取消报警  把变量清零
 108   1              {
 109   2                      flag_alarm = 0;   
 110   2                      flag_bufang = 0; 
 111   2                      flag_bufang_en = 0;     
 112   2                      flag_value = 0; 
 113   2                      P2 = 0xff;      
 114   2              }                       
 115   1      }
