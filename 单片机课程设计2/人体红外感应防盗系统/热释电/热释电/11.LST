   1          #include <reg52.h>               //调用单片机头文件
   2          #define uchar unsigned char  //无符号字符型 宏定义      变量范围0~255
   3          #define uint  unsigned int       //无符号整型 宏定义    变量范围0~65535
   4          
   5          #define key_io P1
   6          uchar key_can;
   7          
   8          //   红外热释电平时为0  有输出为1
   9          
  10          sbit beep = P2^3;          //蜂鸣器定义
  11          sbit red  = P2^2;          //红色发光二极管定义
  12          sbit green = P2^1;         //绿色发光二极管定义
  13          sbit yellow = P2^0;        //黄色发光二极管定义
  14          sbit hw    = P1^3;         //红外热释传感器定义
  15          bit flag_300ms = 0;
  16          
  17          /****************独立按键处理函数************************/         
  18          void key()
  19          {
  20   1              static uchar key_new = 0,key_old = 0,key_value = 0;
  21   1              if(key_new == 0)                 //按键松开
  22   1              {
  23   2                      if((key_io & 0x07) == 0x07)
  24   2                              key_value ++;
  25   2                      else 
  26   2                              key_value = 0;
  27   2                      if(key_value >= 5)       //按键松开松手检测
  28   2                      {
  29   3                              key_value = 0;
  30   3                              key_new = 1;    //按键松开后进入等待按键状态
  31   3                      }
  32   2              }
  33   1              else 
  34   1              {
  35   2                      if((key_io & 0x07) != 0x07)      //按键按下
  36   2                              key_value ++;
  37   2                      else 
  38   2                              key_value =0;
  39   2                      if(key_value >= 5)      //按键按下消抖
  40   2                      {
  41   3                              key_value = 0;
  42   3                              key_new = 0;       //按键松开后进入等待松开按键状态
  43   3                      }
  44   2              }
  45   1              key_can = 20;
  46   1              if((key_new == 0) && (key_old == 1))
  47   1              {
  48   2                      switch(key_io & 0x07)
  49   2                      {
  50   3                              case 0x06: key_can = 1; break;    //得到按键值 
  51   3                              case 0x05: key_can = 2; break;    //得到按键值 
  52   3                              case 0x03: key_can = 3; break;    //得到按键值 
  53   3                      }
  54   2              }                        
  55   1              key_old = key_new;       
