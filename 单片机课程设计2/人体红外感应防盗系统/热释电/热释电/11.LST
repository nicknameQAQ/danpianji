 121          /******************主程序**********************/           
 122          void main()
 123          {
 124   1              time_init();
 125   1              while(1)
 126   1              {
 127   2                      key();            
 128   2                      yellow = ~hw;    //红外热释电指示灯 有输出就亮黄灯
 129   2                      if(key_can < 10)
 130   2                      {
 131   3                              key_with();      //按键设置函数
 132   3                      }
 133   2                      if(flag_300ms == 1)
 134   2                      {
 135   3                              flag_300ms = 0;
 136   3                              hongwai_dis();     //红外报警函数
 137   3                      }       
 138   2              }
 139   1      }
