   1          /*********** 基于89C52RC的电压测量表*****************/
   2          /******** 作者：孙玮 学号：14200106214***************/
   3          /*系统主要实现功能：通过ADC0832将读取到的模拟量转化**/
   4          /*为数字量，并通过单片机进行读取然后显示在数码管上***/
   5          /*并且可以通过串行口读取到所测量的电压值。此外，该***/
   6          /*电路通过电阻分压可以实现多个量程的测量*************/
   7          
   8          #include <reg52.h>                  //52系列单片机头文件定义
   9          #include <stdio.h>                  //C语言头文件定义
  10          
  11          //***************************
  12          //*******引脚定义************
  13          //***************************
  14          //ADC0832控制口定义
  15          sbit    CS =P2^0;                   //CS：片选使能信号输出端
  16          sbit    CLK=P2^1;                   //CLK：时钟信号输出端
  17          sbit    DIO=P2^2;                   //DI/DO信号输出端（由于D0与D1在通信时不会同时有效，所以共用一个IO口）
  18          
  19          //数码管控制引脚定义（数据引脚共8个，使用P0）
  20          sbit    S_1=P1^0;                   //第一个数码管阳极控制端
  21          sbit    S_2=P1^1;                   //第二个数码管阳极控制端
  22          sbit    S_3=P1^2;                   //第三个数码管阳极控制端
  23          sbit    S_4=P1^3;                   //第四个数码管阳极控制端
  24          
  25          //量程与继电器控制引脚定义
  26          sbit    KEY=P1^4;                   //用于量程的选择以及继电器的控制
  27          
  28          //***************************
  29          //*******常量定义************
  30          //***************************
  31          unsigned int table[]={0xc0,0xf9,0xa4,0xb0,0x99,0x92,0x82,0xf8,0x80,0x90};
  32                                              //0~9在共阳数码管中所对应的十六进制值
  33          //***************************
  34          //*******延时1000us**********
  35          //***************************
  36          void delay_1000us()                 //简单延时函数,约延时1000us
  37          {               
  38   1              unsigned char i=1000;
  39   1              while(i--);
  40   1      }
  41          
  42          //***************************
  43          //*******ADC0832读取程序*****
  44          //***************************
  45          unsigned int ADC0832()              //此处编程参考ADC0832英文手册
  46          {   
  47   1          unsigned int i,buff;            //缓存数据定义
  48   1                                          //一个读取周期开始 
  49   1          CS=1;                           //CS置一，转换开始
  50   1          CLK=0;                          //为第一个时钟信号做准备
  51   1          CS=0;                           //芯片使能
  52   1          DIO=1;                          //给发送DI发送起始电平
  53   1          CLK=1;                          //第一个时钟开始
  54   1          CLK=0;                          //第一个时钟结束
  55   1          DIO=1;                          //给DI发送高电平，选择单通道模式
C51 COMPILER V9.00   MAIN                                                                  07/08/2016 14:45:03 PAGE 2   

  56   1          CLK=1;                          //第二个时钟开始
  57   1          CLK=0;                          //第二个时钟结束
  58   1          DIO=0;                          //给DI发送低电平，选择通道0
  59   1          CLK=1;                          //第三个时钟开始
  60   1          CLK=0;                          //第三个时钟结束
  61   1          DIO=1;                          //DO置一，准备读取数据
  62   1          for(i=0;i<8;i++)                //读取八位数据,由高到低读取
  63   1          {
  64   2              CLK=1;                      //时钟信号拉高
  65   2              CLK=0;                      //下降沿有效，进行读取数据
  66   2              buff<<=1;                   //将下面储存的低位数据向右移
  67   2                  buff|=DIO;                  //将输出数据DIO通过或运算储存在buff最低位 
  68   2          }
  69   1          CS=1;                           //测量完毕，将CS拉高，片选无效
  70   1          return buff; 
  71   1      }
  72          
  73          //***************************
  74          //*******串口初始化程序******
  75          //***************************
  76          void UartInit(void)                         //串行口初始化
  77          {
  78   1              SCON=0x50;                              //8位数据,可变波特率  
  79   1              TMOD=0x20;                              //设定定时器1为16位自动重装方式
  80   1              TL1=0xFD;                               //设定定时初值
  81   1              TH1=0xFD;                               //设定定时初值
  82   1              ET1=0;                              //禁止定时器1中断
  83   1              TR1=1;                              //启动定时器1
  84   1      }
  85          
  86          //***************************
  87          //*******主程序**************
  88          //***************************
  89          void main()
  90          {
  91   1          unsigned int buff,ge,shi,bai;   //缓存数据定义
  92   1          UartInit();                     //串口初始化   
  93   1          while(1)                        //死循环
  94   1          {                               //主函数程序开始
  95   2              buff=ADC0832()*100;         //读取AD的值，并进行修正
  96   2              buff=buff/51;               //精度修正，转换为000~500范围
  97   2              bai=buff/100;               //保存buff的百位
  98   2              shi=(buff%100)/10;          //保存buff的十位
  99   2              ge=buff%10;                 //保存buff的个位
 100   2                                          //数码管显示程序
 101   2              if(KEY==1)                  //如果KEY为1，量程设为0~5V
 102   2              {
 103   3              S_1=0;                      //选通第一位数码管，显示第一位数
 104   3              P0=table[0];                //P0口输出8位数据
 105   3              delay_1000us();             //短暂延时
 106   3              P0=0xff;                    //数码管消隐
 107   3              S_1=1;                      //关闭第一位数码管
 108   3      
 109   3              S_2=0;                      //选通第二位数码管，显示第二位数
 110   3              P0=table[bai]&0x7f;         //P0口输出8位数据，因为量程为为0~5V，所以第一位后显示小数点
 111   3              delay_1000us();             //短暂延时
 112   3              P0=0xff;                    //数码管消隐
 113   3              S_2=1;                      //关闭第二位数码管
 114   3      
 115   3              S_3=0;                      //选通第三位数码管，显示第三位数
 116   3              P0=table[shi];              //P0口输出8位数据
 117   3              delay_1000us();             //短暂延时
C51 COMPILER V9.00   MAIN                                                                  07/08/2016 14:45:03 PAGE 3   

 118   3              P0=0xff;                    //数码管消隐
 119   3              S_3=1;                      //关闭第三位数码管
 120   3      
 121   3              S_4=0;                      //选通第四位数码管，显示第四位数
 122   3              P0=table[ge];               //P0口输出8位数据
 123   3              delay_1000us();             //短暂延时
 124   3              P0=0xff;                    //数码管消隐
 125   3              S_4=1;                      //关闭第四位数码管
 126   3                                          //串口发送程序
 127   3              TI=1;                       //TI置一，开始发送数据     
 128   3              printf("%d.%d%d\n",bai,shi,ge);        
 129   3                                          //将buff/100后发出
 130   3              while(!TI);                 //直到数据发送完毕
 131   3              TI=0;                       //数据发送完毕后，TI置〇
 132   3              }
 133   2              else                        //如果KEY为1，量程设为0~50V
 134   2              {
 135   3              S_1=0;                      //选通第一位数码管，显示第一位数
 136   3              P0=table[0];                //P0口输出8位数据
 137   3              delay_1000us();             //短暂延时
 138   3              P0=0xff;                    //数码管消隐
 139   3              S_1=1;                      //关闭第一位数码管
 140   3      
 141   3              S_2=0;                      //选通第二位数码管，显示第二位数
 142   3              P0=table[bai];              //P0口输出8位数据
 143   3              delay_1000us();             //短暂延时
 144   3              P0=0xff;                    //数码管消隐
 145   3              S_2=1;                      //关闭第二位数码管
 146   3      
 147   3              S_3=0;                      //选通第三位数码管，显示第三位数
 148   3              P0=table[shi]&0x7f;         //P0口输出8位数据，因为量程为为0~50V，所以第二位后显示小数点
 149   3              delay_1000us();             //短暂延时
 150   3              P0=0xff;                    //数码管消隐
 151   3              S_3=1;                      //关闭第三位数码管
 152   3      
 153   3              S_4=0;                      //选通第四位数码管，显示第四位数
 154   3              P0=table[ge];               //P0口输出8位数据
 155   3              delay_1000us();             //短暂延时
 156   3              P0=0xff;                    //数码管消隐
 157   3              S_4=1;                      //关闭第四位数码管
 158   3                                          //串口发送程序
 159   3              TI=1;                       //TI置一，开始发送数据     
 160   3              printf("%d%d.%d\n",bai,shi,ge);        
 161   3                                          //将buff/100后发出
 162   3              while(!TI);                 //直到数据发送完毕
 163   3              TI=0;                       //数据发送完毕后，TI置〇
 164   3              }
 165   2          }
 166   1      }


