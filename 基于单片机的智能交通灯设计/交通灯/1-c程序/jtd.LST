 338   2                      P1=0Xfb;        //第三位显示
 339   2                      delay(1);       //延时
 340   2                      P1=0Xf7;        //第四位显示
 341   2                      delay(1);       //延时
 342   2                  P1 = 0xff;  //灭显示
 343   2              }
 344   1      }
