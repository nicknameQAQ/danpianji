  17   1              if         ((P1 & 0x01) == 0x00) P0 ^= 0x01;
  18   1              else if((P1 & 0x02) == 0x00) P0 ^= 0x02;
  19   1              else if((P1 & 0x04) == 0x00) P0 ^= 0x04; 
