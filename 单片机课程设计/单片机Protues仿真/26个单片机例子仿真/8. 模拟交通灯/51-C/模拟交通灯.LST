   1          /*
   2          *模拟交通灯*
   3          */
   4          #include <reg51.h>
   5          typedef unsigned char uint8;
   6          typedef unsigned int uint16;
   7          
   8          void delay(uint16 x)
   9          {
  10   1              uint16 i,j;
  11   1              for(i = x; i > 0; i --)
  12   1                      for(j = 114; j > 0; j --);              
  13   1      }
  14          
  15          #define    RED_EW_ON()  P0 &= ~0x01                     //东西方向指示灯开
  16          #define YELLOW_EW_ON()  P0 &= ~0x02
  17          #define  GREEN_EW_ON()  P0 &= ~0x04
  18          
  19          #define    RED_EW_OFF() P0 |=  0x01                     //东西方向指示灯关
  20          #define YELLOW_EW_OFF() P0 |=  0x02
  21          #define  GREEN_EW_OFF() P0 |=  0x04
  22          
  23          #define  RED_SN_ON()    P0 &= ~0x08                     //南北方向指示灯开  0000100 1111011
  24          #define YELLOW_SN_ON()  P0 &= ~0x10
  25          #define GREEN_SN_ON()   P0 &= ~0x20
  26          
  27          #define  RED_SN_OFF()   P0 |=  0x08                     //南北方向指示灯关
  28          #define YELLOW_SN_OFF() P0 |=  0x10
  29          #define GREEN_SN_OFF()  P0 |=  0x20
  30          
  31          #define YELLOW_EW_BLINK() P0 ^= 0x02                    //东西方向黄灯闪烁
  32          #define YELLOW_SN_BLINK() P0 ^= 0x10                    //南北方向黄灯闪烁
  33          
  34          uint8 Flash_Count = 0, Operation_Type = 1;                      //闪烁次数，操作类型变量
  35          
  36          void Traffic_Light()                                                            //交通灯切换子程序
  37          {
  38   1              switch (Operation_Type)
  39   1              {
  40   2                      case 1://东西方向绿灯与南北方向红灯亮
  41   2                                      RED_EW_OFF(); YELLOW_EW_OFF(); GREEN_EW_ON();
  42   2                                  RED_SN_ON(); YELLOW_SN_OFF(); GREEN_SN_OFF();
  43   2                                      delay(2000);                                                            //延时
  44   2                                      Operation_Type = 2;                                                     //下一个操作
  45   2                                      break;
  46   2      
  47   2                      case 2://东西方向黄灯开始闪烁，绿灯关闭
  48   2                                      delay(120);
  49   2                                      YELLOW_EW_BLINK();
  50   2                                      GREEN_EW_OFF();
  51   2                                      //闪烁5次
  52   2                                      if( ++Flash_Count != 10) return;
  53   2                                      Flash_Count = 0;
  54   2                                      Operation_Type = 3;                                                     //下一个操作
  55   2                                      break;
C51 COMPILER V8.02   模拟交通灯                                                            07/31/2011 10:09:59 PAGE 2   

  56   2      
  57   2                      case 3://东西方向红灯与南北方向绿灯亮
  58   2                                      RED_EW_ON();  YELLOW_EW_OFF(); GREEN_EW_OFF();
  59   2                                      RED_SN_OFF(); YELLOW_SN_OFF(); GREEN_SN_ON();
  60   2                                 //南北方向绿灯亮若干秒后切换
  61   2                                 delay(2000);
  62   2                                 Operation_Type = 4;                                                  //下一个操作
  63   2                                 break;
  64   2      
  65   2                      case 4://南北方向红灯开始闪烁
  66   2                                 delay(120);
  67   2                                 YELLOW_SN_BLINK();
  68   2                                 GREEN_SN_OFF();
  69   2                                 //闪烁5次
  70   2                                 if( ++ Flash_Count != 10) return;
  71   2                                 Flash_Count = 0;
  72   2                                 Operation_Type = 1;                                                  //回到第一种操作
  73   2              }                  
  74   1      }
  75          
  76          //主程序
  77          int main()
  78          {
  79   1              while(1) Traffic_Light();
  80   1      }


