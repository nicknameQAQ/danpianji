 330          /* 整型数转换为字符串，str-字符串指针，dat-待转换数，返回值-字符串长度 */
 331          unsigned char IntToString(unsigned char *str, int dat)
 332          {
 333   1          signed char i = 0;
 334   1          unsigned char len = 0;
 335   1          unsigned char buf[6];
 336   1          
 337   1          if (dat < 0)  //如果为负数，首先
 338   1              
 339   1          {
 340   2              dat = -dat;
 341   2              *str++ = '-';
 342   2              len++;
 343   2          }
 344   1          do {          //先转换为低位在前的十进制数组
 345   2              buf[i++] = dat % 10;
 346   2              dat /= 10;
 347   2          } while (dat > 0);
 348   1          len += i;     //i最后的值就是有效字符的个数
 349   1          while (i-- > 0)   //将数组值转换为ASCII码反向拷贝到接收指针上
 350   1          {
 351   2              *str++ = buf[i] + '0';
 352   2          }
 353   1      
 354   1          *str = '\0';  //添加字符串结束符
 355   1          
 356   1          return len;   //返回字符串长度
 357   1      }
