   1          #include<reg51.h>
   2          sbit START=P3^4;                           //ATART，ALE接口。0->1->0:启动AD转换。
   3          sbit EOC=P3^3;                     //转换完毕由0变1.
   4          #define OUTPORT P2 
   5          
   6                                                                                                          //AD转换函数，返回转换结果。                                                                                            //转换结果是3位数，小数点在百位与十位之间。
   7          unsigned int uiADTransform()
   8          {
   9   1              unsigned int uiResult;
  10   1              START=1;                         //启动AD转换。
  11   1              START=0;
  12   1              while(EOC==0);           //等待转换结束。
  13   1              uiResult=OUTPORT;        //出入转换结果。
  14   1              uiResult=(100*uiResult)/51;                //处理运算结果。
  15   1              return uiResult;
  16   1      }


