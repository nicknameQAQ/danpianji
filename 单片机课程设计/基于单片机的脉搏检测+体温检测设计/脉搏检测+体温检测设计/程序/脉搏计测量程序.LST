 590          /*************定时器0中断服务程序***************/
 591          void time0_int() interrupt 1
 592          {       
 593   1              TH0 = 0x3c;
 594   1              TL0 = 0xb0;     // 50ms  12M
 595   1              timecount++;//每50ms一次计数
 596   1          oneminte++;
 597   1              flat300ms++;
 598   1              if(timecount>50 &&yemian==0 )     //当超过50*50ms=2.5s左右没有检测到信号停止显示
 599   1              {
 600   2                              i=0;//数据个数清零
 601   2                              timecount=0;//50ms计数清零
 602   2                              displayOK=0;//显示关
 603   2                          oneminte=0;
 604   2                          rate=0; 
 605   2                          display(0x06,'W');
 606   2                  display(0x07,'a');
 607   2                          display(0x08,'i');
