 558          void int0() interrupt 0
 559          {
 560   1              if(time1>=8)
 561   1               {
 562   2                        time1=0;
 563   2                if(i==3)//记录到超过等于3次时间
 564   2                              {
 565   3                                      i=1;//计数从1开始
 566   3                                      displayOK=1;    //测得3次开始显示
 567   3                  }   
 568   2                              
 569   2                      
 570   2                              if( oneminte>200 && flag==0 && yemian==0) 
 571   2                     { 
 572   3                                       flag=1;
 573   3                                       rate1=rate*6;
 574   3                      
 575   3                                       display(0x09,'/');
 576   3                               display(0x0a,'m');
 577   3                           display(0x0b,'i');
 578   3                       display(0x0c,'n');
