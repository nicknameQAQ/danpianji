 370          unsigned char adc0832(unsigned char CH) 
 371          {        
 372   1              unsigned char i,test,adval;      
 373   1              adval = 0x00;      
 374   1              test = 0x00;       
 375   1              Clk = 0;       //初始化      
 376   1              DATI = 1;     
 377   1              _nop_();     
 378   1              CS = 0;     
 379   1              _nop_();     
 380   1              Clk = 1;    
 381   1              _nop_();       
 382   1              if ( CH == 0x00 )      //通道选择    
 383   1              {         
 384   2                      Clk = 0;         
 385   2                      DATI = 1;      //通道0的第一位       
 386   2                       _nop_();       
 387   2                       Clk = 1;         
 388   2                       _nop_();          
 389   2                       Clk = 0;        
 390   2                       DATI = 0;      //通道0的第二位       
 391   2                       _nop_();  
 392   2                       Clk = 1;       
 393   2                       _nop_();     
 394   2              }      
 395   1              else     
 396   1              {         
 397   2                      Clk = 0;        
 398   2                      DATI = 1;      //通道1的第一位        
 399   2                      _nop_();        
 400   2                      Clk = 1;        
 401   2                      _nop_();        
 402   2                      Clk = 0;        
 403   2                      DATI = 1;      //通道1的第二位     
 404   2                      _nop_();      
 405   2                      Clk = 1;      
 406   2                      _nop_();     
 407   2              }        
 408   1                      Clk = 0;       
 409   1                      DATI = 1;        
 410   1                      for( i = 0;i < 8;i++ )      //读取前8位的值     
 411   1                      {         
 412   2                              _nop_();         
 413   2                              adval <<= 1;        
 414   2                              Clk = 1;        
 415   2                              _nop_();        
 416   2                              Clk = 0;        
 417   2                              if (DATO)            
 418   2                              adval |= 0x01;       
 419   2                              else            
 420   2                              adval |= 0x00;     
 421   2                      }          
 422   1                      for (i = 0; i < 8; i++)      //读取后8位的值       
 423   1                      {             
 424   2                              test >>= 1;            
 425   2                              if (DATO)                
 426   2                              test |= 0x80;            
 427   2                              else                 
C51 COMPILER V9.00   程序                                                                  06/08/2020 10:11:17 PAGE 8   

 428   2                              test |= 0x00;            
 429   2                              _nop_();           
 430   2                              Clk = 1;           
 431   2                              _nop_();           
 432   2                              Clk = 0;       
 433   2                      }        
 434   1                      if (adval == test)      //比较前8位与后8位的值，如果不相同舍去。若一直出现显示为零，请将该行去掉        
             -     
 435   1                      dat = test;        
 436   1                      _nop_();         
 437   1                      CS = 1;        //释放ADC0832        
 438   1                      DATO = 1;        
 439   1                      Clk = 1;       
 440   1                      return dat; 
 441   1      } 
