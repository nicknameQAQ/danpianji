 207   1               //主机设为输入 判断从机响应信号 
 208   1               TRH=1;
 209   1               //判断DHT11是否有低电平响应信号 如不响应则跳出，响应则向下运行   
 210   1               if(!TRH)   
 211   1               {
 212   2                      respond=2;
 213   2                      //判断DHT11发出 80us 的低电平响应信号是否结束 
 214   2                      while((!TRH)&& respond++);
 215   2                      respond=2;
 216   2                      //判断从机是否发出 80us 的高电平，如发出则进入数据接收状态
 217   2                      while(TRH && respond++);
 218   2                      //数据接收状态   
 219   2                      RH_temp = receive(); 
 220   2                      RL_temp = receive(); 
 221   2                      TH_temp = receive(); 
 222   2                      TL_temp = receive(); 
 223   2                      CK_temp = receive();
 224   2                      TRH=1;//ST=1;     
 225   2                      //数据校验 
 226   2                      untemp=(RH_temp+RL_temp+TH_temp+TL_temp);
 227   2                      if(untemp==CK_temp)
 228   2                      {
 229   3                           RH_data = RH_temp;
 230   3                           RL_data = RL_temp;
 231   3                           TH_data = TH_temp; 
 232   3                           TL_data = TL_temp;
 233   3                           CK_data = CK_temp;
 234   3                      }
 235   2              }
 236   1                                      //湿度整数部分
