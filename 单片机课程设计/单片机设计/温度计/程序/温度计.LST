 118           /**********ds18b20初始化函数**********************/
 119          void Init_DS18B20(void) 
 120          {
 121   1               unsigned char x=0;
 122   1               DQ = 1;          //DQ复位
 123   1               delay_18B20(8);  //稍做延时
 124   1               DQ = 0;          //单片机将DQ拉低
 125   1               delay_18B20(80); //精确延时 大于 480us
 126   1               DQ = 1;          //拉高总线
 127   1               delay_18B20(14);
 128   1               x=DQ;            //稍做延时后 如果x=0则初始化成功 x=1则初始化失败
 129   1               delay_18B20(20);
 130   1      }
 131          /***********ds18b20读一个字节**************/  
 132           uchar ReadOneChar(void)
 133          {
 134   1              uchar i=0;
 135   1              uchar dat = 0;
 136   1              for (i=8;i>0;i--)
 137   1               {
 138   2                        DQ = 0; // 给脉冲信号
 139   2                        dat>>=1;
 140   2                        DQ = 1; // 给脉冲信号
 141   2                        if(DQ)
 142   2                        dat|=0x80;
 143   2                        delay_18B20(4);
 144   2               }
 145   1              return(dat);
 146   1      }
 147          
 148          /*************ds18b20写一个字节****************/  
 149          void WriteOneChar(uchar dat)
 150          {
 151   1              unsigned char i=0;
 152   1              for (i=8; i>0; i--)
 153   1              {
 154   2                      DQ = 0;
 155   2                      DQ = dat&0x01;
 156   2              delay_18B20(5);
 157   2                      DQ = 1;
 158   2              dat>>=1;
 159   2       }
 160   1      }
