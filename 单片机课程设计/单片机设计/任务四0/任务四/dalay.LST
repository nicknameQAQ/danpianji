   1          #include "dalay.h"      
   2          typedef unsigned int u16;         //对数据类型进行声明定义
   3          typedef unsigned char u8;
   4          
   5          int sec=0;               //定义秒的初始值
   6          
   7          
   8          /*******************************************************************************
   9          * 函 数 名         : Timer0Init
  10          * 函数功能                 : 定时器0初始化
  11          * 输    入         : 无
  12          * 输    出         : 无
  13          *******************************************************************************/
  14          void Timer0Init()
  15          {
  16   1              TMOD|=0X01;//选择为定时器0模式，工作方式1，仅用TR0打开启动。
  17   1      
  18   1              TH0=0XFC;       //给定时器赋初值，定时1ms
  19   1              TL0=0X18;       
  20   1              ET0=1;//打开定时器0中断允许
  21   1              EA=1;//打开总中断
  22   1              TR0=1;//打开定时器                      
  23   1      }
  24          
  25          
  26          /*******************************************************************************
  27          * 函 数 名         : void Timer0() interrupt 1
  28          * 函数功能                 : 定时器0中断函数
  29          * 输    入         : 无
  30          * 输    出         : 无
  31          *******************************************************************************/
  32          void Timer0() interrupt 1
  33          {
  34   1              static u16 i;
  35   1              TH0=0XFC;       
  36   1              TL0=0X18;
  37   1              i++;
  38   1              if(i==1000)             //给定时器赋初值，定时1ms
  39   1              {
  40   2                      i=0;
  41   2                      sec++;  
  42   2              }       
  43   1      }


