 148          #ifdef LCD12864_PICTURE
              
              unsigned char LCD12864_ReadData(void)
              {
                      unsigned char i, readValue;
              
                      i = 0;
                      while( LCD12864_Busy() == 0)
                      {
                              LCD12864_Delay1ms(1);
                              i++;
                              if( i>100)
                              {
                                      return 0;          //超过等待退出
                              }       
                      }
              
                      LCD12864_RS = 1;       //选择命令
                      LCD12864_RW = 1;
                      LCD12864_EN = 0;
                      LCD12864_Delay1ms(1);  //等待
              
                      LCD12864_EN = 1;
                      LCD12864_Delay1ms(1);
                      readValue = LCD12864_DATAPORT;
                      LCD12864_EN = 0;
              
                      return readValue;
              }
              
              #endif
