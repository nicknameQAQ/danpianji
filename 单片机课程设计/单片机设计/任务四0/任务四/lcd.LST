  13          /*******************************************************************************
  14          * 函 数 名         : Lcd1602_Delay1ms
  15          * 函数功能                 : 延时函数，延时1ms
  16          * 输    入         : c
  17          * 输    出         : 无
  18          * 说    名         : 该函数是在12MHZ晶振下，12分频单片机的延时。
  19          *******************************************************************************/
  20          
  21          
  22          void Delay1ms(unsigned int c)
  23          {
  24   1          unsigned char a,b;
  25   1              for(; c>0; c--)
  26   1              {
  27   2                  for(b=100; b>0; b--)
  28   2                      {
  29   3                      for(a=1; a>0; a--);
  30   3                      }
  31   2              }
  32   1      }
  33          
  34           void LCD12864_char(unsigned char x,unsigned char y)                               //定位显示
  35          {
