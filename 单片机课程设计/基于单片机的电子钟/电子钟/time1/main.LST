  39          /*****************************与ds1302相关函数*********************************/
  40          
  41          void write_ds1302_byte(uchar dat)   //ds1302写一字节
  42          {
  43   1              uchar i;
  44   1              for(i=0;i<8;i++)   //分8次循环，把（add）一位一位的写入
  45   1              {
  46   2                      ds1302_sclk=0;  
  47   2                      ds1302_io =dat&0x01;   //dat和0x01进行按位与，保留最低位。即从低位开始写入
  48   2                      dat=dat>>1;   //add右移一位
  49   2                      ds1302_sclk=1; 
  50   2              }
  51   1      }
  52          
  53          void ds1302_write(uchar add,uchar date)  //单字节写操作函数（包含地址和数据）
  54          {
C51 COMPILER V9.01   MAIN                                                                  06/14/2020 15:22:09 PAGE 2   

  55   1              ds1302_ce=0;      
  56   1              ds1302_sclk=0;     
  57   1              ds1302_ce=1;     //ce变为高电平，允许单片机向DS1302中的寄存器写入地址命令和数据
  58   1              _nop_();         
  59   1              write_ds1302_byte(add);    //写入控制命令（指明写入的寄存器地址及后续的操作为写操作）
  60   1              write_ds1302_byte(date);   //写入一个字节数据
  61   1              ds1302_ce=0;     //地址命令和数据写完之后，把ce拉低，防止对写入的数据进行误操作
  62   1              _nop_();         
  63   1              ds1302_io =1;    //释放IO数据线
  64   1              ds1302_sclk=1;   //释放sclk时钟线
  65   1      }
  66           
  67          uchar ds1302_read(uchar add)  //单字节读操作函数
  68          {
  69   1              uchar i,value;
  70   1              ds1302_ce=0;     
  71   1              ds1302_sclk=0;    
  72   1              ds1302_ce=1;  //ce变为高电平，单片机向DS1302中的寄存器写入地址命令，并读出数据
  73   1              _nop_();        //稍微延时（一个机器周期）
  74   1              write_ds1302_byte(add);   //写入控制命令,（指明要读取的寄存器地址及后续的操作为读操作）
  75   1              for(i=0;i<8;i++)   //分8次循环，把数据一位一位的读出
  76   1              {
  77   2                      value=value>>1;     //value右移一位
  78   2                      ds1302_sclk=0;    //把sclk时钟置为低电平，开始读取数据
  79   2                      if(ds1302_io)
  80   2                      {
  81   3                              value=value|0x80;    //把I0读到的值，放到value 的最高位
  82   3                      }
  83   2                      ds1302_sclk=1; 
  84   2              }
  85   1              ds1302_ce=0;      //一个字节的数据读完之后，把ce拉低
  86   1              _nop_();
  87   1              ds1302_sclk=0;     //释放sclk时钟线
  88   1              _nop_();
  89   1              ds1302_sclk=1;
  90   1              ds1302_io=1;      //释放io数据线
  91   1              return value;    //把 value值返回
  92   1      }
  93          
  94          void set_rtc()   //设置时间初值函数
  95          {
  96   1              uchar i,j,k;
