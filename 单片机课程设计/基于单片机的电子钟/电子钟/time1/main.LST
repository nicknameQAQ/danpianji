 479          void xianshi()  //1602液显示函数
 480          {
 481   1        //读秒分时，日月年，星期              
 482   1              miao=bcd_decimal(ds1302_read(0x81));  
 483   1              fen =bcd_decimal(ds1302_read(0x83));
 484   1              shi =bcd_decimal(ds1302_read(0x85));
C51 COMPILER V9.01   MAIN                                                                  06/14/2020 15:22:09 PAGE 9   

 485   1              ri  =bcd_decimal(ds1302_read(0x87));
 486   1              yue =bcd_decimal(ds1302_read(0x89));
 487   1              nian=bcd_decimal(ds1302_read(0x8d));
 488   1              week=bcd_decimal(ds1302_read(0x8b));
 489   1        //送液晶显示          
 490   1              write_time2(6,miao);
 491   1              write_time2(3,fen);
 492   1              write_time2(0,shi);
 493   1              write_time1(8,ri);
 494   1              write_time1(5,yue);
 495   1              write_time1(2,nian);
 496   1              write_week(week);       
 497   1       
 498   1      }
