 135          void lcd1602_init()              //LCD1602初始化函数    
 136          {
 137   1              uchar lcdnum;
 138   1              lcd_write_com(0x38);  
 139   1              lcd_write_com(0x0c);   
 140   1              lcd_write_com(0x06);   
 141   1              lcd_write_com(0x01);   
 142   1      
 143   1              lcd_write_com(0x80);                 //写第一行数据 
 144   1              for(lcdnum=0;lcdnum<16;lcdnum++)              
 145   1              {
 146   2                      lcd_write_date(table1[lcdnum]);
 147   2                      delay(2);
 148   2              }
 149   1              lcd_write_com(0x80+0x40);                        //写入第二行数据 
 150   1              for(lcdnum=0;lcdnum<16;lcdnum++)
 151   1              {
 152   2                      lcd_write_date(table2[lcdnum]);
 153   2                      delay(2);
 154   2              }
 155   1      }
