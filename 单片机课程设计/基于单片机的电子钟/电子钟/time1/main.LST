 179          uchar bcd_decimal(uchar bcd)              //bcd转换十进制
 180          {
 181   1              uchar decimal;
 182   1              decimal=bcd>>4;
 183   1              decimal=decimal*10+(bcd&=0x0f);
 184   1              return decimal;         
 185   1      }
