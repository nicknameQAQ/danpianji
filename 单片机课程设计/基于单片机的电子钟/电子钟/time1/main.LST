 159          void write_time1(uchar add,uchar date)    //日期送显示
 160          {       
 161   1              uchar shi,ge;
 162   1              shi=date/10;
 163   1              ge=date%10;
 164   1              lcd_write_com(0x80+add);
 165   1              lcd_write_date(0x30+shi);
 166   1              lcd_write_date(0x30+ge);
 167   1      }
 168          
 169          void write_time2(uchar add,uchar date)    //时间送显示
 170          {       
 171   1              uchar shi,ge;
 172   1              shi=date/10;
