 113          void lcd_write_com(uchar com)   //写命令函数
 114          {
 115   1              lcd1602_rs=0;     //数据命令选择端，写命令时设为0
 116   1              lcd1602_rw=0;    //读写选择端，写时设为0
 117   1              lcd1602_en=0;  
 118   1              P0=com;        //将要写的命令送到数据总线上
 119   1              lcd1602_en=1;   //使能端电平变换，形成一个高脉冲将命令写入到液晶控制器
 120   1              delay(5);       //延时
 121   1              lcd1602_en=0;           
 122   1      }
 123          
 124          void lcd_write_date(uchar date)    //写数据函数
 125          {
 126   1          lcd1602_rs=1;      //数据命令选择端，写数据时设为1
 127   1              lcd1602_rw=0;     //读写选择端，写时设为0
 128   1              lcd1602_en=0;
 129   1              P0=date;       //将要写的数据送到数据总线上
 130   1              lcd1602_en=1;  //使能端电平变换，形成一个高脉冲将命令写入到液晶控制器
 131   1              delay(5);       //延时
 132   1              lcd1602_en=0;   
 133   1      }
