 121   1        wrc(0x80+0x43);
 122   1        if(c==0x80) //读取到负温度即为补码，要将其转换成源码
 123   1        {
 124   2          wrd('-');
 125   2          temp=temp-1;
 126   2          temp=(~temp)|0x80;//负数的补码即为反码+1；而负数的反码为其源码取反，除了符号位；正数的补码等于正数的反码
             -等于正数的源码
 127   2        } 
 128   1        else
 129   1        {
 130   2          wrd('+');
 131   2          temp=(temp);
 132   2        }     
 133   1        wrd(num[temp/100]);
 134   1        wrd(num[temp%100/10]);
 135   1        wrd(num[temp%100%10]);
 136   1        wrd('.');
 137   1        wrd(num[k/1000]);
 138   1        wrd(num[k%1000/100]);
 139   1        wrd(0xdf);
 140   1        wrd('C');
 141   1      }
