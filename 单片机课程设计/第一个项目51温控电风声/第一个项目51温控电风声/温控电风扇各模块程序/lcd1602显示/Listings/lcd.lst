  66          void ds18b20wr(uint8 dat)   //18b20写数据
  67          {
  68   1        uint8 i;
  69   1        for(i=0;i<8;i++)
  70   1        {
  71   2          dq=0;
  72   2          dq=dat&0x01;
  73   2          dat>>=1;
  74   2          delay(8);//在时序上只有这一块对时序要求最准确，他的时间必须大于15us
  75   2          dq=1;
  76   2          delay(1);
  77   2        } 
  78   1      }
  79          uint8 ds18b20rd()     //18b20读数据
  80          {
  81   1        uint8 value,i;
  82   1        for(i=0;i<8;i++)  
  83   1        {
  84   2          dq=0;
  85   2          value>>=1;
  86   2          dq=1;
  87   2          if(dq==1)value|=0x80;
  88   2          delay(8);//在这一块也对时间要求特别准确，整段程序必须大于60us   
  89   2        }
  90   1        return value;
  91   1      }
  92          uint8 readtemp()        //读取温度内需要复位的
  93          {
  94   1        uint8 b;
  95   1        ds18b20init();    //初始化
  96   1        ds18b20wr(0xcc);   //发送忽略ROM指令
  97   1        ds18b20wr(0x44);   //发送温度转换指令
  98   1        delay(100);
  99   1        ds18b20init();     //初始化
 100   1        ds18b20wr(0xcc);   //发送忽略ROM指令
 101   1        ds18b20wr(0xbe);   //发读暂存器指令
 102   1        a=ds18b20rd();   //温度的低八位
 103   1        b=ds18b20rd();   //温度的高八位
 104   1        b<<=4;       //ssss s***；s为标志位s=0表示温度值为正数，s=1温度值为负数
 105   1        c=b&0x80;   //温度正负标志位确认
 106   1        b+=(a&0xf0)>>4;
 107   1        a=a&0x0f;   //温度的小数部分
 108   1        return b;
 109   1      }
 110          void display()
 111          {
 112   1        uint16 i,k;
 113   1        float dio;
 114   1        dio=a*0.0625;
 115   1        k=dio*10000;//取小数点后两位有效数字
 116   1        wrc(0x80+0x00);
