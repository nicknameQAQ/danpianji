 363          //从IIC总线接收一个字节数据
 364          uchar AT24C04_RecvByte()
 365          {
 366   1          uchar i;
 367   1          uchar dat = 0;
 368   1      
 369   1          SDA = 1;                    //使能内部上拉,准备读取数据
 370   1          for (i=0; i<8; i++)         //8位计数器
 371   1          {
 372   2              dat <<= 1;
 373   2              SCL = 1;                //拉高时钟线
 374   2              Delay5us();             //延时
 375   2              dat |= SDA;             //读数据
 376   2              SCL = 0;                //拉低时钟线
 377   2              Delay5us();             //延时
 378   2          }
 379   1      
 380   1          return dat;
 381   1      }
 382          //从AT24C04读取1页(16字节)数据,将设备的00~0F地址中的数据读出存放在DATA区的BUF中
 383          void AT24C04_ReadPage()
 384          {
 385   1          uchar i;
 386   1      
