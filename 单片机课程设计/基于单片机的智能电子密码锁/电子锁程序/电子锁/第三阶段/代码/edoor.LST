 294          //起始信号
 295          void AT24C04_Start()
 296          {
 297   1          SDA = 1;                    //拉高数据线
 298   1          SCL = 1;                    //拉高时钟线
 299   1          Delay5us();                 //延时
 300   1          SDA = 0;                    //产生下降沿
 301   1          Delay5us();                 //延时
 302   1          SCL = 0;                    //拉低时钟线
 303   1      }
 304          //停止信号
 305          void AT24C04_Stop()
 306          {
 307   1          SDA = 0;                    //拉低数据线
 308   1          SCL = 1;                    //拉高时钟线
 309   1          Delay5us();                 //延时
 310   1          SDA = 1;                    //产生上升沿
 311   1          Delay5us();                 //延时
 312   1      }
 313          //发送应答信号
 314          void AT24C04_SendACK(bit ack)
 315          {
 316   1          SDA = ack;                  //写应答信号
 317   1          SCL = 1;                    //拉高时钟线
 318   1          Delay5us();                 //延时
 319   1          SCL = 0;                    //拉低时钟线
 320   1          Delay5us();                 //延时
 321   1      }
 322          //接收应答信号
 323          bit AT24C04_RecvACK()
 324          {
 325   1          SCL = 1;                    //拉高时钟线
 326   1          Delay5us();                 //延时
 327   1          CY = SDA;                   //读应答信号
 328   1          SCL = 0;                    //拉低时钟线
 329   1          Delay5us();                 //延时
 330   1      
 331   1          return CY;
 332   1      }
 333          //向IIC总线发送一个字节数据
 334          void AT24C04_SendByte(uchar dat)
 335          {
 336   1          uchar i;
 337   1      
 338   1          for (i=0; i<8; i++)         //8位计数器
 339   1          {
 340   2              dat <<= 1;              //移出数据的最高位
 341   2              SDA = CY;               //送数据口
 342   2              SCL = 1;                //拉高时钟线
 343   2              Delay5us();             //延时
 344   2              SCL = 0;                //拉低时钟线
 345   2              Delay5us();             //延时
 346   2          }
 347   1          AT24C04_RecvACK();
 348   1      }
 349          //向AT24C04写1页(16字节)数据,将TESTDATA开始的16个测试数据写如设备的00~0F地址中
 350          void AT24C04_WritePage()
 351          {
C51 COMPILER V9.52.0.0   EDOOR                                                             03/25/2015 15:02:01 PAGE 7   

 352   1          uchar i;
 353   1      
 354   1          AT24C04_Start();            //起始信号
 355   1          AT24C04_SendByte(0xa0);     //发送设备地址+写信号
 356   1          AT24C04_SendByte(0x00);     //发送存储单元地址
 357   1          for (i=0; i<16; i++)
 358   1          {
 359   2              AT24C04_SendByte(TESTDATA[i]);
 360   2          }
 361   1          AT24C04_Stop();             //停止信号
