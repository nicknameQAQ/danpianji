  62          //-------------
  63          //忙检查
  64          //-----------------------------
  65          uchar Busy_Check()
  66          {
  67   1              uchar LCD_Status;
  68   1              RS=0;  //       寄存器选择
  69   1              RW=1; //读状态寄存器
  70   1              EN=1;  // 开始读
  71   1              DelayMS(1);
  72   1              LCD_Status=P1;
  73   1              EN=0;
  74   1              return  LCD_Status;
  75   1      
  76   1      }
  77          //----------------------------
  78          //写LCD命令
  79          //---------------------------------
  80          void Write_LCD_Command(uchar cmd)
  81          {
  82   1                 while((Busy_Check()&0x80)==0x80);   //忙等待
  83   1                 RS=0;  //选择命令寄存器
  84   1                 RW=0;  //写
  85   1                 EN=0;
  86   1                 P1=cmd;EN=1;DelayMS(1);EN=0;
  87   1      }
  88          //--------------------------------------
  89          //发送数据
  90          //---------------------------------------
  91          void Write_LCD_Data(uchar dat)
  92          {
  93   1               while((Busy_Check()&0x80)==0x80);   //忙等待   
  94   1                RS=1;  RW=0; EN=0; P1=dat;EN=1;DelayMS(1);EN=0;       
  95   1      }
  96          //------------------------------------
  97          //LCD初始化
