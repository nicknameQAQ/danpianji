 165   1       WriteSet1302(0x80,((0/10)<<4|(0%10)));   //根据写秒寄存器命令字，写入秒的初始值
 166   1       WriteSet1302(0x82,((12/10)<<4|(12%10)));   //根据写分寄存器命令字，写入分的初始值
 167   1       WriteSet1302(0x84,((11/10)<<4|(11%10))); //根据写小时寄存器命令字，写入小时的初始值
 168   1       WriteSet1302(0x86,((25/10)<<4|(25%10))); //根据写日寄存器命令字，写入日的初始值
 169   1       WriteSet1302(0x88,((1/10)<<4|(1%10))); //根据写月寄存器命令字，写入月的初始值
 170   1       WriteSet1302(0x8c,((13/10)<<4|(13%10)));   //nian
 171   1       WriteSet1302(0x8a,((1/10)<<4|(1%10)));
 172   1      }
