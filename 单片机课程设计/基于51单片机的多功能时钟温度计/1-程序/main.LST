 937          void delay_18B20(unsigned int i)//延时1微秒
 938          {
 939   1              while(i--);
 940   1      }
 941          void ds1820rst()/*ds1820复位*/
 942           {  unsigned char x=0;
 943   1               DQ = 1;          //DQ复位
 944   1               delay_18B20(4);  //延时
 945   1               DQ = 0;          //DQ拉低
 946   1               delay_18B20(100); //精确延时大于480us
 947   1               DQ = 1;          //拉高
 948   1               delay_18B20(40);        
 949   1         }  
 950            
 951             uchar ds1820rd()/*读数据*/
 952            { unsigned char i=0;
 953   1               unsigned char dat = 0;
 954   1               for (i=8;i>0;i--)
 955   1               {   DQ = 0; //给脉冲信号
 956   2                        dat>>=1;
 957   2                        DQ = 1; //给脉冲信号
 958   2                        if(DQ)
 959   2                        dat|=0x80;
 960   2                        delay_18B20(10);
 961   2               }
 962   1              return(dat);
 963   1        }
 964          
 965            void ds1820wr(uchar wdata)/*写数据*/
 966            {unsigned char i=0;
 967   1          for (i=8; i>0; i--)
 968   1         { DQ = 0;
 969   2           DQ = wdata&0x01;
 970   2           delay_18B20(10);
 971   2           DQ = 1;
 972   2           wdata>>=1;
 973   2         }
 974   1       }
 975          read_temp()/*读取温度值并转换*/
 976           {uchar a,b;
 977   1        ds1820rst();    
 978   1        ds1820wr(0xcc);//*跳过读序列号*/
 979   1        ds1820wr(0x44);//*启动温度转换*/
 980   1        ds1820rst();    
 981   1        ds1820wr(0xcc);//*跳过读序列号*/ 
 982   1        ds1820wr(0xbe);//*读取温度*/ 
 983   1        a=ds1820rd();
C51 COMPILER V9.00   MAIN                                                                  03/11/2014 13:48:13 PAGE 17  

 984   1        b=ds1820rd();
 985   1        tvalue=b;
 986   1        tvalue<<=8;
 987   1        tvalue=tvalue|a;
 988   1          if(tvalue<0x0fff)
 989   1         tflag=0;
 990   1          else
 991   1         {tvalue=~tvalue+1;
 992   2               tflag=1;
 993   2         }
 994   1        tvalue=tvalue*(0.625);//温度值扩大10倍，精确到1位小数
 995   1              return(tvalue);
 996   1        }
 997          void ds1820disp()//温度值显示
 998                  { uchar flagdat;
 999   1                disdata[0]=tvalue/1000+0x30;//百位数
1000   1           disdata[1]=tvalue%1000/100+0x30;//十位数
1001   1           disdata[2]=tvalue%100/10+0x30;//个位数
1002   1           disdata[3]=tvalue%10+0x30;//小数位
1003   1          
1004   1           if(tflag==0)
1005   1                  flagdat=0x20;//正温度不显示符号
1006   1           else
1007   1             flagdat=0x2d;//负温度显示负号:-
1008   1      
1009   1           if(disdata[0]==0x30)
1010   1                 {disdata[0]=0x20;//如果百位为0，不显示
1011   2                       if(disdata[1]==0x30)
1012   2                        {disdata[1]=0x20;//如果百位为0，十位为0也不显示
1013   3                        }
1014   2                      }
1015   1      
1016   1                 write_com(0xc9);
1017   1                 write_date(flagdat);//显示符号位
1018   1                 write_com(0xca);
1019   1                 write_date(disdata[0]);//显示百位
1020   1                 write_com(0xcb);
1021   1                 write_date(disdata[1]);//显示十位    
1022   1                 write_com(0xcc);
1023   1                 write_date(disdata[2]);//显示个位    
1024   1                 write_com(0xcd);
1025   1                 write_date(0x2e);//显示小数点        
1026   1                 write_com(0xce);
1027   1                 write_date(disdata[3]);//显示小数位
1028   1                 write_com(0xcf);
1029   1                 write_date('C');
