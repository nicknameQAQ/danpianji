 105          void Write1302(uchar dat)
 106          {
 107   1        uchar i; 
 108   1        SCLK=0;           //拉低SCLK，为脉冲上升沿写入数据做好准备
 109   1        delay1(2);       //稍微等待，使硬件做好准备
 110   1        for(i=0;i<8;i++)      //连续写8个二进制位数据
 111   1          {
 112   2           DATA=dat&0x01;    //取出dat的第0位数据写入1302
 113   2        delay(2);       //稍微等待，使硬件做好准备
 114   2         SCLK=1;           //上升沿写入数据
 115   2         delay1(2);      //稍微等待，使硬件做好准备
 116   2         SCLK=0;           //重新拉低SCLK，形成脉冲
 117   2         dat>>=1;          //将dat的各数据位右移1位，准备写入下一个数据位
C51 COMPILER V9.00   MAIN                                                                  03/11/2014 13:48:13 PAGE 3   

 118   2         }
 119   1       }
