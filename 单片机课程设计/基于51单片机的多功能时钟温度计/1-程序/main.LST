 121           void WriteSet1302(uchar Cmd,uchar dat)
 122           {
 123   1         RST=0;           //禁止数据传递
 124   1         SCLK=0;          //确保写数居前SCLK被拉低
 125   1         RST=1;           //启动数据传输
 126   1         delay1(2);     //稍微等待，使硬件做好准备
 127   1         Write1302(Cmd);  //写入命令字
 128   1         Write1302(dat);  //写数据
 129   1         SCLK=1;          //将时钟电平置于已知状态
 130   1         RST=0;           //禁止数据传递
 131   1       }
 132          
 133          uchar Read1302(void)
 134           {
 135   1         uchar i,dat;
 136   1         delay(2);       //稍微等待，使硬件做好准备
 137   1         for(i=0;i<8;i++)   //连续读8个二进制位数据
 138   1         {
 139   2          dat>>=1;       //将dat的各数据位右移1位，因为先读出的是字节的最低位
 140   2          if(DATA==1)    //如果读出的数据是1
 141   2          dat|=0x80;    //将1取出，写在dat的最高位
 142   2          SCLK=1;       //将SCLK置于高电平，为下降沿读出
 143   2          delay1(2);  //稍微等待
 144   2          SCLK=0;       //拉低SCLK，形成脉冲下降沿
 145   2          delay1(2);  //稍微等待
 146   2          }  
 147   1        return dat;        //将读出的数据返回
 148   1        }
 149          
 150          uchar  ReadSet1302(uchar Cmd)
 151           {
 152   1        uchar dat;
 153   1        RST=0;                 //拉低RST
 154   1        SCLK=0;                //确保写数居前SCLK被拉低
 155   1        RST=1;                 //启动数据传输
 156   1        Write1302(Cmd);       //写入命令字
 157   1        dat=Read1302();       //读出数据
 158   1        SCLK=1;              //将时钟电平置于已知状态
 159   1        RST=0;               //禁止数据传递
 160   1        return dat;          //将读出的数据返回
 161   1      }
