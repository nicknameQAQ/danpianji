  90   1          CLK=0;
  91   1          delay1(2);
  92   1          DI=1;        
  93   1          CLK=1;       
  94   1          delay1(2);//第一个脉冲，起始位 
  95   1          CLK=0;                                        
  96   1          delay1(2);                                    
  97   1          DI=1;                                         
  98   1          CLK=1;                                        
  99   1          delay1(2);//第二个脉冲，DI=1表示双通道单极性输入     
 100   1          CLK=0;                                                                               
 101   1          delay1(2);                                                                           
 102   1          DI=temp;    /*******************************/                                                                                        
 103   1          CLK=1;
 104   1          delay1(2);//第三个脉冲，DI=1表示选择通道1（CH2）      
 105   1          DI=0;                                                                                  
 106   1          DO=1;//DI转为高阻态，DO脱离高阻态为输出数据作准备
 107   1          CLK=1;                                                                                                                                                                               
 108   1          delay1(2);                                                                     
 109   1          CLK=0;                                                                         
 110   1          delay1(2);//经实验，这里加一个脉冲AD便能正确读出数据， 
 111   1              //不加的话读出的数据少一位（最低位d0读不出）              
 112   1              for(i=0;i<8;i++)                                                                          
 113   1          { 
 114   2              CLK=1;
 115   2              delay1(2);
 116   2              CLK=0;
 117   2              delay1(2);
C51 COMPILER V9.00   001                                                                   03/23/2017 20:22:24 PAGE 3   

 118   2              aa=(aa<<1)|DO;//在每个脉冲的下降沿DO输出一位数据，最终ch为8位二进制数
 119   2              }
 120   1          CS=1;//取消片选，一个转换周期结束
 121   1          return(aa);//把转换结果返回
 122   1      }
 123          uint fenjie(bit cc)
 124          {
 125   1              uchar dd;
 126   1              uint  ee;
