  82          void dis_num(void)
  83          {
  84   1              unsigned char i=0,j=0,k=0;
  85   1              LCD_write_command(0x01);//清除屏幕显示
  86   1              character[0] = fre/10000000;
  87   1              character[1] = fre/1000000%10;
  88   1              character[2] = fre/100000%10;
  89   1              character[3] = fre/10000%10;
  90   1              character[4] = fre/1000%10;
  91   1              character[5] = fre/100%10;
  92   1              character[6] = fre/10%10;
  93   1              character[7] = fre%10;
  94   1          character[8] = 'H';
  95   1              character[9] = 'z';
  96   1              for(i = 0;i<4;i++)               //显示“fre=”
  97   1              {
  98   2                      LCD_disp_char(i+0,1,character_1[i]);
  99   2              }
 100   1              for(i = 0;i<10;i++)      //判断第一个不为0的数
 101   1              {
 102   2                      if(character[i]!=0)
 103   2                              break;
 104   2              }
 105   1              k = 8-i;
 106   1              for(j = 0;j<k;j++)       //显示所有的数字
 107   1              {
 108   2                              LCD_disp_num(4+j,1,character[i++]);     
 109   2              }
 110   1          for(i = 5;i<7;i++)   //显示“Hz”
 111   1              {
 112   2                      LCD_disp_char(j+4,1,character_1[i]);
 113   2                      j++;
 114   2              }
 115   1      }
