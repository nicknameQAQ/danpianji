 132          //-------------------定时/计数器初始化--------------
 133          void timer_init(void)         //定时/计数器初始化
 134          { 
 135   1              TMOD=0x66;                //计数器0和计数器1工作工作方式2，自动重装初值 
 136   1              TH0=0;                    //计数器初值为0
 137   1              TL0=0;
 138   1              TR0=1;                    //计数器开始计数          
 139   1              ET0=1;                    //打开计数器0中断   
 140   1              TH1=0;                    //计数器初值为0
 141   1              TL1=0;
 142   1              TR1=1;                    //计数器开始计数          
 143   1              ET1=1;                    //打开计数器1中断   
 144   1              RCAP2H=(65536-62500)/256; //在程序初始化的时候给RCAP2L和RCAP2H赋值， 
 145   1              RCAP2L=(65536-62500)%256; //TH2和TL2将会在中断产生时自动使TH2=RCAP2H,TL2=RCAP2L。 
 146   1              TH2=RCAP2H;               //12M晶振下每次中断62.5ms(1s=1000ms=62.5ms×16)
 147   1              TL2=RCAP2L;
 148   1              ET2=1;                    //打开定时器2中断      
 149   1              TR2=1;                    //定时器2开始计时  
 150   1              EA=1;                     //开总中断   
 151   1      } 
 152          //------------------中断函数----------------------
 153          void timer2(void) interrupt 5 //定时器2中断(62.5ms)
 154          {
 155   1              time++;
 156   1              TF2=0;                    //定时器2的中断标志位TF2不能够由硬件清零，所以要在中断服务程序中将其清零
 157   1              if (time==16)             //定时1s时间到  
 158   1              {
 159   2                 time=0;                //计时清0
 160   2                 EA=0;                  //关中断               
 161   2                 fre=(long)count1*256+TL1;     //count*256强制转换成long型，否则将不产生进位~先判断分频后(计数器1)
 162   2                 FLAG = 0; 
 163   2                
 164   2                 if(fre<2000)//如果不到200KHz则读取分频前(计数器0)频率(200K÷100=2000)
 165   2                 {
 166   3                              fre = (long)count*256+TL0;
 167   3                              FLAG = 1;          
 168   3                 } 
 169   2                      if(!FLAG)
 170   2                      {
 171   3                              fre = fre *100;//100分频
 172   3                      }
 173   2                 TL0=0;                 //清零计数器0计数         
 174   2                 TH0=0;
 175   2                 TL1=0;
 176   2                 TH1=0; 
 177   2                 count=0;               //清零计数器0计数       
 178   2                 count1=0;
C51 COMPILER V9.01   PINLVJI                                                               04/30/2014 06:53:20 PAGE 4   

 179   2                 EA=1;                  //开中断          
 180   2              }
 181   1      } 
