   1          #include<reg51.h>
   2          #include"delay.h"
   3          #include"lcd602.h"
   4          //**************端口定义******************* 
   5          sbit en=P2^7; //6  液晶使能端
   6          sbit rw=P2^6; //5 液晶读写选择端
   7          sbit rs=P2^5; //4 液晶数据命令选择端
   8          //**************变量定义*******************
   9          //**************数组定义*******************
  10          /*******************************************************************
  11                            写命令
  12          ************************************************************************/
  13          void xiemingling(unsigned char mingling)
  14          {
  15   1        en=0;
  16   1        rs=0;
  17   1        rw=0;
  18   1        P0=mingling;
  19   1        delayxms(5);
  20   1        en=1;
  21   1        delayxms(10);
  22   1        en=0;
  23   1      }
  24          /*******************************************************************
  25                            写数据
  26          ************************************************************************/
  27          void xieshuju(unsigned char shuju)
  28          {   
  29   1        en=0;
  30   1        rs=1;
  31   1        rw=0;
  32   1        P0=shuju;
  33   1        delayxms(5);
  34   1        en=1;
  35   1        delayxms(10);
  36   1        en=0;
  37   1      }
  38          /*******************************************************************
  39                            液晶初始化
  40          ************************************************************************/
  41          void chushihua()
  42          {
  43   1        delayxms(20); //给液晶一段时间
  44   1        en=0;
  45   1        xiemingling(0x38);//设置16*2显示，5*7点阵，8位数据接口
  46   1        delayxms(20);
  47   1        xiemingling(0x38);//
  48   1        delayxms(20);
  49   1        xiemingling(0x0c);//设置开显示，不显示光标
  50   1        delayxms(20);
  51   1        xiemingling(0x06);//写一个字符后地址指针加1
  52   1        delayxms(20);
  53   1        xiemingling(0x01);//显示清零，数据指针清零
  54   1        delayxms(20);
  55   1        xiemingling(0x80);//指定字符显示的实际地址，，，显示位置的确定方法规定为"80H+地址码x"
C51 COMPILER V9.00   LCD1602                                                               09/22/2018 14:21:12 PAGE 2   

  56   1        delayxms(20);
  57   1      }
  58          /***********************lcd1602上显示这些字符函数************************/
  59          void write_string(uchar hang,uchar add,uchar *p)
  60          {
  61   1              if(hang==1)   
  62   1                      xiemingling(0x80+add);
  63   1              else
  64   1                      xiemingling(0x80+0x40+add);
  65   1                      while(1)                                                                                                                 
  66   1                      {
  67   2                              if(*p == '\0')  break;
  68   2                              xieshuju(*p);
  69   2                              p++;
  70   2                      }       
  71   1      }
