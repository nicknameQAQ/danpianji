  85          /***********************lcd1602上显示特定的字符************************/
  86          void write_zifu(uchar hang,uchar add,uchar date)
  87          {
  88   1              if(hang==1)   
  89   1                      xiemingling(0x80+add);
  90   1              else
  91   1                      xiemingling(0x80+0x40+add);
  92   1              xieshuju(date); 
  93   1      }
  94          /***********************lcd1602上显示三位十进制数************************/
  95          void write_num3(uchar hang,uchar add,uint date)
  96          {
  97   1              if(hang==1)   
  98   1                      xiemingling(0x80+add);
  99   1              else
 100   1              xiemingling(0x80+0x40+add);
 101   1              xieshuju(0x30+date/100%10);
 102   1      //      xieshuju('.');
 103   1              xieshuju(0x30+date/10%10);
 104   1      //      xieshuju('.');
 105   1              xieshuju(0x30+date%10); 
 106   1      } 
 107          /***********************lcd1602上显示2位十进制数************************/
 108          void write_num2(uchar hang,uchar add,uint date)
 109          {
 110   1              if(hang==1)   
 111   1                      xiemingling(0x80+add);
 112   1              else
 113   1                  xiemingling(0x80+0x40+add);
 114   1              xieshuju(0x30+date/10);
 115   1              xieshuju(0x30+date%10); 
 116   1      } 
