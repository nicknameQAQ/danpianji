 231   1      	{
 232   2      		switch(work_status)//工作状态判断
 233   2      		{
 234   3      			case START_QD_STATUS://开始抢答状态
 235   3      				start_qd_status();
 236   3      				break;
 237   3      			case WAIT_QD_STATUS://等待选手抢答状态
 238   3      				wait_qd_status();
 239   3      				break;
 240   3      			case ACK_QD_STATUS://选手回答状态
 241   3      				ack_qd_status();
C51 COMPILER V6.12  QIANGDA                                                                01/13/2015 23:02:50 PAGE 5   

 242   3      				break;
 243   3      			default:
 244   3      				break;
 245   3      		}
 246   2      		display(qd_time, qd_num);//数码管显示
 247   2      	}
 248   1      }
