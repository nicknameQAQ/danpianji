 182   2      		qd_num = 0;
 183   2      		qd_time = 0;
 184   2      
 185   2      		for(i=0;i<3;i++)//选手回答问题超时警报
 186   2      		{
 187   3      			beep = 1;
 188   3      			delay50ms(5);
 189   3      			beep = 0;
 190   3      			delay50ms(5);
 191   3      		}
 192   2      
 193   2      		work_status = START_QD_STATUS;//设置工作状态为开始抢答状态
 194   2      	}
 195   1      	if(end_qd_pin == 0)//结束按键按下
 196   1      	{
 197   2      		end_Timer0();//结束定时器0
 198   2      		qd_num = 0;
 199   2      		qd_time = 0;
 200   2      		work_status = START_QD_STATUS;//设置工作状态为开始抢答状态
 201   2      	}
 202   1      }
