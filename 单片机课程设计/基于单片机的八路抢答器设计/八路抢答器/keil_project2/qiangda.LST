 204          /*-----数码管显示函数
 205          二位数码管显示倒计时时间
 206          一位数码管显示抢答选手号------*/
 207          void display(unsigned char qd_time, unsigned char qd_num)
 208          {
 209   1      	P2 = weixuan[qd_time/10];//显示时间十位
 210   1      	DG1 = 1;		//打开第一位数码管位选
 211   1      	delay2ms();
 212   1      	DG1 = 0;
 213   1      
 214   1      	P2 = weixuan[qd_time%10];//显示时间个位
 215   1      	DG2 = 1;		//打开第二位数码管位选
 216   1      	delay2ms();
 217   1      	DG2 = 0;
 218   1      
 219   1      	P2 = weixuan[qd_num%10];//显示选手号
 220   1      	DG3 = 1;		//打开第三位数码管位选
 221   1      	delay2ms();
 222   1      	DG3 = 0;
 223   1      }
