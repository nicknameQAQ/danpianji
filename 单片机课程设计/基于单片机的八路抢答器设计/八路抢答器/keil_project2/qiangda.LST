 175          /*------选手回答问题状态------*/
 176          void ack_qd_status()
 177          {
 178   1      	unsigned char i = 0;
 179   1      	if(qd_time == 0)//答题超时
C51 COMPILER V6.12  QIANGDA                                                                01/13/2015 23:02:50 PAGE 4   

 180   1      	{
