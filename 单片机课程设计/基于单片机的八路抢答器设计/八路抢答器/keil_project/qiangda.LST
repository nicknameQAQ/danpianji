 187          /*------选手回答问题状态------*/
 188          void ack_qd_status()
 189          {
 190   1      	unsigned char i = 0;
 191   1      	if(qd_time == 0)//答题超时
 192   1      	{
 193   2      		end_Timer0();//结束定时器0
 194   2      		qd_num = 0;
 195   2      		qd_time = 0;
 196   2      
 197   2      		for(i=0;i<3;i++)//选手回答问题超时警报
 198   2      		{
 199   3      			beep = 1;
 200   3      			delay50ms(5);
 201   3      			beep = 0;
 202   3      			delay50ms(5);
 203   3      		}
 204   2      
 205   2      		work_status = START_QD_STATUS;//设置工作状态为开始抢答状态
 206   2      	}
 207   1      	if(end_qd_pin == 0)//结束按键按下
 208   1      	{
 209   2      		end_Timer0();//结束定时器0
 210   2      		qd_num = 0;
 211   2      		qd_time = 0;
 212   2      		work_status = START_QD_STATUS;//设置工作状态为开始抢答状态
 213   2      	}
 214   1      }
 215          /*-------随机选手回答状态-------*/
 216          void ack_srand_status()
