 291          /*定时器0中断处理函数*/
 292          void Timer0Interrupt(void) interrupt 1
 293          {
 294   1      	timeout_num++;
 295   1          TH0 = 0x3C;
 296   1          TL0 = 0x0B0;
 297   1      
 298   1      	if(timeout_num==20)
 299   1      	{
 300   2      		timeout_num=0;
 301   2      		qd_time--;
 302   2      	}
 303   1      }
