 242          /*-----数码管显示函数
 243          二位数码管显示倒计时时间
 244          一位数码管显示抢答选手号------*/
 245          void display(unsigned char qd_time, unsigned char qd_num)
 246          {
 247   1      	P2 = weixuan[qd_time/10];//显示时间十位
 248   1      	DG1 = 1;		//打开第一位数码管位选
 249   1      	delay2ms();
 250   1      	DG1 = 0;
 251   1      
 252   1      	P2 = weixuan[qd_time%10];//显示时间个位
 253   1      	DG2 = 1;		//打开第二位数码管位选
 254   1      	delay2ms();
 255   1      	DG2 = 0;
 256   1      
 257   1      	P2 = weixuan[qd_num%10];//显示选手号
 258   1      	DG3 = 1;		//打开第三位数码管位选
 259   1      	delay2ms();
 260   1      	DG3 = 0;
 261   1      }
 262          
 263          /*-------主函数-----*/
 264          void main()
 265          {
 266   1      	init();//初始化
 267   1      
 268   1      	while(1)
 269   1      	{
 270   2      		switch(work_status)//工作状态判断
 271   2      		{
 272   3      			case START_QD_STATUS://开始抢答状态
 273   3      				start_qd_status();
 274   3      				break;
 275   3      			case WAIT_QD_STATUS://等待选手抢答状态
 276   3      				wait_qd_status();
 277   3      				break;
 278   3      			case ACK_QD_STATUS://选手回答状态
 279   3      				ack_qd_status();
 280   3      				break;
 281   3      			case ACK_SRAND_QD_STATUS://随机选手回答状态
 282   3      				ack_srand_status();
 283   3      				break;
 284   3      			default:
 285   3      				break;
 286   3      		}
 287   2      		display(qd_time, qd_num);//数码管显示
 288   2      	}
 289   1      }
