  77          /*----------等待开始抢答状态
  78          该状态下一直等待主席台按下开始抢答按钮或随机抢答按钮，再进入相应的工作状态！
  79          这种状态机的编程方式是当前单片机开发者的主流思想。
  80          ---------*/
  81          void start_qd_status(void)
  82          {
  83   1      	if(start_qd_pin == 0)//检测到开始抢答按钮按下
  84   1      	{
  85   2      		work_status = WAIT_QD_STATUS;//工作状态设置为等待答题状态
  86   2      		qd_num = 0;			//回答选手号为0，等待选手按下
  87   2      		qd_time = 20;		//20s抢答时间
  88   2      		timeout_num=0;		//中断次数清0
  89   2      		InitTimer0();		//开启定时器0
  90   2      	}
  91   1      	if(start_srand_qd_pin == 0)//检测到随机抽取选手答题按钮按下
  92   1      	{
  93   2      		work_status = ACK_SRAND_QD_STATUS;//工作状态设置为随机选手回答状态
  94   2      		srand(TL0%100);				//产生随机数种子，srand和rand函数有兴趣可以百度一下单片机产生随机数方法！
  95   2      		qd_num = (rand()%9);//0-8， 产生随机数
  96   2      		if(qd_num == 0)			//防止产生随机数0
  97   2      			qd_num = (rand()%9);	//再次产生随机数
  98   2      		qd_time = 30;				//30s答题时间
  99   2      		timeout_num=0;				//中断次数清0
 100   2      		InitTimer0();				//开始定时器0
 101   2      	}
 102   1      }
