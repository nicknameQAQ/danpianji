 241          //软复位程序
 242          char SHTXX_softreset(void)
 243          // resets the sensor by a softreset 
 244          { 
 245                  unsigned char error=0; 
 246                  SHTXX_Init();              //启动连接复位
 247                  error+=SHTXX_write_byte(RESET);       //发送复位命令
 248                  return error;                     //error=1 通讯错误
 249          }
 250            */
