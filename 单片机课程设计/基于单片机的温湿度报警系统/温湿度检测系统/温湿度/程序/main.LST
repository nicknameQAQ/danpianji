 315          
 316          void Covert_HT()
 317          {
 318   1              value humi_val,temp_val;                //定义两个共同体，一个用于湿度，一个用于温度
 319   1              uchar checksum;                 //CRC    
 320   1              uchar error=0;
 321   1              error=0;                                           //初始化error=0，即没有错误
 322   1              error+=SHTXX_measure((unsigned char*)&temp_val.i,&checksum,TEMP); //温度测量
 323   1              error+=SHTXX_measure((unsigned char*)&humi_val.i,&checksum,HUMI); //湿度测量
 324   1              if(error!=0) SHTXX_Init();                 ////如果发生错误，系统复位
 325   1              else
 326   1              { 
 327   2                      humi_val.f=(float)humi_val.i;                   //转换为浮点数
 328   2                      temp_val.f=(float)temp_val.i;                   //转换为浮点数
 329   2                      SHTXX_calc(&humi_val.f,&temp_val.f);            //修正相对湿度及温度
 330   2                      
 331   2                      real_tempure =temp_val.f+1;        //修正一下偏
 332   2                      real_humi    = humi_val.f-1;
 333   2      
 334   2                      if(real_tempure>=0)
 335   2                      {
 336   3                      TEMP_BUF[0]=real_tempure/100+'0';               //温度百位
 337   3                      
 338   3                      if (TEMP_BUF[0]==0x30) TEMP_BUF[0]=0x20;
 339   3                      TEMP_BUF[1]=real_tempure%100/10+'0';            //温度十位      
 340   3                      if (TEMP_BUF[1]==0x30 && TEMP_BUF[0]==0x30) TEMP_BUF[1]=0x20;
 341   3                      TEMP_BUF[2]=real_tempure%10+'0';                        //温度个位 
 342   3                      
 343   3                      }
 344   2                      else  //负温度
 345   2                      {
 346   3                              TEMP_BUF[0]     ='-';
 347   3                              TEMP_BUF[1]=(real_tempure*(-1))%100/10+'0';             //温度十位      
 348   3                              if (TEMP_BUF[1]==0x30 && TEMP_BUF[0]==0x30) TEMP_BUF[1]=0x20;
 349   3                              TEMP_BUF[2]=(real_tempure*(-1))%10+'0';                 //温度个位
 350   3                              
 351   3                      }               
 352   2                      TEMP_BUF[3]=0xdf;
 353   2                      TEMP_BUF[4]=0x43;
 354   2                      HUMI_BUF[0]=real_humi/100+'0';                  //湿度百位
 355   2                      if (HUMI_BUF[0]==0x30) HUMI_BUF[0]=0x20;
 356   2                      HUMI_BUF[1]=real_humi%100/10+'0';       //湿度十位      
 357   2                      if (HUMI_BUF[1]==0x30 && HUMI_BUF[0]==0x30) HUMI_BUF[1]=0X20;  
 358   2                      HUMI_BUF[2]=real_humi%10+'0';                   //湿度个位
 359   2                      HUMI_BUF[3]= '%';
 360   2      
 361   2              }
 362   1      }
