 254          //温湿度测量
 255          char SHTXX_measure(unsigned char *p_value, unsigned char *p_checksum, unsigned char mode)
 256          // 进行温度或者湿度转换，由参数mode决定转换内容；
 257          { 
 258   1      //      enum {TEMP,HUMI};                //已经在头文件中定义
 259   1              unsigned error=0;
 260   1              unsigned int i;
 261   1      
 262   1              SHTXX_transstart();                   //启动传输
 263   1              switch(mode)                     //选择发送命令
 264   1          {   
 265   2                      case TEMP : error+=SHTXX_write_byte(MEASURE_TEMP); break;                  //测量温度
 266   2              case HUMI : error+=SHTXX_write_byte(MEASURE_HUMI); break;                  //测量湿度
 267   2              default     : break; 
 268   2              }
 269   1              for (i=0;i<65535;i++) if(DATA==0) break; //等待测量结束
 270   1              if(DATA) error+=1;                // 如果长时间数据线没有拉低，说明测量错误 
 271   1              *(p_value) =SHTXX_read_byte(ACK);    //读第一个字节，高字节 (MSB)
 272   1              *(p_value+1)=SHTXX_read_byte(ACK);    //读第二个字节，低字节 (LSB)
 273   1              *p_checksum =SHTXX_read_byte(noACK); //read CRC校验码
 274   1              return error;                                    // error=1 通讯错误
 275   1      }
 276          
 277          //温湿度值标度变换及温度补偿
 278          void SHTXX_calc(float *p_humidity ,float *p_temperature)
 279          { 
 280   1      
 281   1              float rh=*p_humidity;             // rh:      12位 湿度 
 282   1              float t=*p_temperature;           // t:       14位 温度
 283   1              float rh_lin;                     // rh_lin: 湿度 linear值
 284   1              float rh_true;                    // rh_true: 湿度 ture值
 285   1              float t_C;                        // t_C   : 温度 ℃
 286   1      
 287   1              t_C=t*0.01 - 40;                  //补偿温度
 288   1              rh_lin=-0.0000028*rh*rh + 0.0405*rh - 4;     //相对湿度非线性补偿
 289   1              rh_true=rh/33;   
 290   1              if(rh_true>26)
 291   1                      rh_true=rh/33+1;
 292   1              if(rh_true>33)
 293   1                      rh_true=rh/33+1.5;
 294   1              if(rh_true>40)
 295   1                      rh_true=rh/33+3;        
 296   1              if(rh_true>50)
 297   1                      rh_true=rh/33+3.7;      
 298   1              if(rh_true>70)
 299   1                      rh_true=rh/33+3;        
 300   1              if(rh_true>90)
 301   1                      rh_true=rh/33+1.6;      
 302   1      
C51 COMPILER V8.02   MAIN                                                                  07/04/2018 10:30:20 PAGE 6   

 303   1          //rh_true=(t_C-25)*(0.01+0.00008*rh)+rh_lin;   //相对湿度对于温度依赖性补偿 ，仿真的时候去掉补偿
 304   1      
 305   1                      
 306   1              if(rh_true>100)rh_true=100;       //湿度最大修正
 307   1              if(rh_true<0.1)rh_true=0.1;       //湿度最小修正
 308   1      
 309   1              *p_temperature=t_C;               //返回温度结果
 310   1              *p_humidity=rh_true;              //返回湿度结果
 311   1      
 312   1      
 313   1      }
