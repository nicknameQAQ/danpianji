 143          //SHT11程序
 144          
 145          
 146          #define noACK 0                         //继续传输数据，用于判断是否结束通讯
 147          #define ACK   1             //结束数据传输；
 148                                                                  //地址  命令  读/写
 149          #define STATUS_REG_W 0x06   //000   0011    0
 150          #define STATUS_REG_R 0x07   //000   0011    1
 151          #define MEASURE_TEMP 0x03   //000   0001    1
 152          #define MEASURE_HUMI 0x05   //000   0010    1
 153          #define RESET        0x1e   //000   1111    0
 154          
 155          
 156          //写字节程序
 157          char SHTXX_write_byte(unsigned char value)   
 158          { 
 159   1              unsigned char i,error=0; 
 160   1              for (i=0x80;i>0;i/=2)             //shift bit for masking 高位为1，循环右移
 161   1              { 
 162   2                      if (i&value) DATA=1;          //和要发送的数相与，结果为发送的位
 163   2              else DATA=0;                        
 164   2              SCK=1;                          
 165   2              _nop_();_nop_();_nop_();        //延时3us 
 166   2              SCK=0;
 167   2              }
 168   1              DATA=1;                           //释放数据线
 169   1              SCK=1;                            
 170   1              error=DATA;                       //检查应答信号，确认通讯正常
 171   1              _nop_();_nop_();_nop_();
 172   1              SCK=0;        
 173   1              DATA=1;
 174   1              return error;                     //error=1 通讯错误
 175   1      }
 176          
 177          //读字节程序
 178          char SHTXX_read_byte(unsigned char ack)
C51 COMPILER V8.02   MAIN                                                                  07/04/2018 10:30:20 PAGE 4   

 179          //----------------------------------------------------------------------------------
 180          { 
 181   1              unsigned char i,val=0;
 182   1              DATA=1;                           //释放数据线
 183   1              for(i=0x80;i>0;i>>=1)             //高位为1，循环右移
 184   1              { 
 185   2                      SCK=1;                         
 186   2              if(DATA) val=(val|i);        //读一位数据线的值 
 187   2              SCK=0;       
 188   2              }
 189   1              DATA=!ack;                        //如果是校验，读取完后结束通讯；
 190   1              SCK=1;                            
 191   1              _nop_();_nop_();_nop_();          //延时3us 
 192   1              SCK=0;   
 193   1              _nop_();_nop_();_nop_();       
 194   1              DATA=1;                           //释放数据线
 195   1              return val;
 196   1      }
 197          
 198          //启动传输
 199          void SHTXX_transstart(void)
 200          // generates a transmission start 
 201          //       _____         ________
 202          // DATA:      |_______|
 203          //           ___     ___
 204          // SCK : ___|   |___|   |______
 205          { 
 206   1              DATA=1; SCK=0;                   //准备
 207   1              _nop_();
 208   1              SCK=1;
 209   1              _nop_();
 210   1              DATA=0;
 211   1              _nop_();
 212   1              SCK=0; 
 213   1               _nop_();_nop_();_nop_();
 214   1              SCK=1;
 215   1              _nop_();
 216   1              DATA=1;     
 217   1              _nop_();
 218   1              SCK=0;     
 219   1      }
 220          
 221          
 222          //连接复位
 223          void SHTXX_Init(void)
 224          // communication reset: DATA-line=1 and at least 9 SCK cycles followed by transstart
 225          //       _____________________________________________________         ________
 226          // DATA:                                                      |_______|
 227          //          _    _    _    _    _    _    _    _    _        ___     ___
 228          // SCK : __| |__| |__| |__| |__| |__| |__| |__| |__| |______|   |___|   |______
 229          { 
 230   1              unsigned char i; 
 231   1              DATA=1; SCK=0;                    //准备
 232   1              for(i=0;i<9;i++)                  //DATA保持高，SCK时钟触发9次，发送启动传输，通迅即复位
 233   1              { 
 234   2                      SCK=1;
 235   2              SCK=0;
 236   2              }
 237   1              SHTXX_transstart();                   //启动传输
 238   1      }
