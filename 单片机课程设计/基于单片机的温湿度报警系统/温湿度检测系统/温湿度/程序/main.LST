 104          void GotoXY(unsigned char x, unsigned char y)
 105          {
 106   1              if(y==0)
 107   1                      LCD_Write(LCD_COMMAND,0x80|x);
 108   1              if(y==1)
 109   1                      LCD_Write(LCD_COMMAND,0x80|(x-0x40));
 110   1      }
