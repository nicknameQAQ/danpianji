 857          /*******************************************************************************
 858          * 函数名         : uchar AD(bit Channel)
 859          * 函数功能               : 采集AD值
 860          * 输入           : 无
 861          * 输出           : 无
C51 COMPILER V9.00   MAIN                                                                  05/31/2020 12:32:34 PAGE 15  

 862          *******************************************************************************/
 863          uchar AD(bit Channel)
 864          {
 865   1              unsigned char i;
 866   1              unsigned char ad0,ad1;
 867   1              ad0 = 0x00;
 868   1              ad1 = 0x00;
 869   1      
 870   1              AD_cs = 0;
 871   1              _nop_();
 872   1              AD_clk=0;
 873   1              _nop_();
 874   1              AD_di=1;
 875   1              _nop_();
 876   1              AD_clk=1;          ////输入开始信号（构成一个正脉冲）,时钟上升沿，输入开始信号 
 877   1                      
 878   1              //单通道0~10.  1~11  双通道 0+~00 。0—~01
 879   1              AD_clk=0;
 880   1              AD_di=1;   //选择单通道
 881   1              AD_clk=1;  
 882   1              _nop_(); 
 883   1              AD_clk=0; 
 884   1              AD_di=Channel;    //选择通道
 885   1      
 886   1              //通道选择完毕
 887   1              AD_clk=1;
 888   1              _nop_();
 889   1              AD_clk=0;
 890   1              _nop_();
 891   1              AD_di=1;                
 892   1      
 893   1              for(i=8;i>0;i--)
 894   1              {
 895   2                      AD_clk=1;
 896   2                      ad0<<=1;
 897   2                      AD_clk=0;
 898   2                      if(AD_do)
 899   2                              ad0 |= 0x01;
 900   2                      else
 901   2                              ad0     |= 0x00;        
 902   2              }
 903   1              for(i=8;i>0;i--)
 904   1              {       
 905   2                      ad1>>=1;                   ////从低位向高位读取八位AD值 
 906   2                      AD_clk=0;
 907   2                      if(AD_do)
 908   2                              ad1 |= 0x80;
 909   2                      else
 910   2                              ad1     |= 0x00;
 911   2                      AD_clk=1;       
 912   2              }
 913   1              AD_cs = 1;
 914   1              AD_do = 1;
 915   1              AD_clk = 1;
 916   1              if(ad0 == ad1)            //判断是否采集正确
 917   1              {
 918   2                      return ad1;
 919   2              }
 920   1              return -1;
 921   1      }


