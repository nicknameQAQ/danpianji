 941          void delay(uint y)                                                                      //DS18B20延时函数（仿真用）
 942          {
 943   1              while(y--);
 944   1      } 
 945          /*
 946          void delay(uint z)                                                                              //DS18B20延时函数（实物用）
 947          {
 948                  uint x,y;
 949                  for(x=z;x>0;x--)
 950                          for(y=1;y>0;y--);
 951          }  
 952          */
 953          void write_byte(uint dat)                       //写一个字节
 954          {
 955   1              uchar i;
 956   1              for(i=0;i<8;i++)                        //循环八次        共有八位
 957   1              {
 958   2                      DQ=0;                                           //写零
 959   2                      DQ=dat&0x01;                //向总线写位数据，从最低位写起
 960   2                      delay(4);
 961   2                      DQ=1;                                           //写一
 962   2                      dat>>=1;                                    //下次写作准备，移位数据
 963   2              }
 964   1              delay(4);
 965   1      }                                    
 966          
 967          uchar read_byte(void)                           //读一个字节，返回值
 968          {
 969   1              uchar i;
 970   1              uint value;
 971   1              for(i=0;i<8;i++)                        //循环八次        共有八位
 972   1              {
 973   2                      DQ=0;
 974   2                      value>>=1;
 975   2                      DQ=1;                                           //释放总线
 976   2                      if(DQ)
 977   2                      value|=0x80;                        //DQ=1，value取1
 978   2                      delay(4);
 979   2              }
 980   1              return value;
 981   1      }
