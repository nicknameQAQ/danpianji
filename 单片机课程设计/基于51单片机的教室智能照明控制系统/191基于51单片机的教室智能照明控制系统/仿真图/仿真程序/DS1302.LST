 156          void LCD_Clean(uchar i)                                 //液晶屏清除显示
 157          {
 158   1              uchar num;
 159   1              if(i==1)
 160   1              {
 161   2                      write_com(0x80);                                //设置初始显示位置
 162   2                      for(num=0;num<16;num++)                 //显示第一行内容
 163   2                      {
 164   3                              write_date(table3[num]);
 165   3                              delay1(1);
 166   3                      }
 167   2              }
 168   1              if(i==2)
 169   1              {
 170   2                      write_com(0x80+0x40);
 171   2                      for(num=0;num<16;num++)                 //显示第二行内容
 172   2                      {
 173   3                              write_date(table3[num]);
 174   3                              delay1(1);
 175   3                      }
 176   2              }
 177   1      }
