 217          void write_ds1302_byte(uchar dat)
 218          {
 219   1              uchar i;
 220   1              for(i=0;i<8;i++)
 221   1              {
 222   2                      sck=0;
 223   2                      io=dat&0x01;                                       //准备数据,从最低位开始
 224   2                      dat=dat>>1;
 225   2                      sck=1;
 226   2              }
 227   1      }
 228          
 229          void write_ds1302(uchar add,uchar dat)
 230          {
 231   1              rst=0;
 232   1              _nop_();                                                //CPU原地踏步
 233   1              sck=0;
 234   1              _nop_();
 235   1              rst=1;
 236   1              _nop_();
 237   1              write_ds1302_byte(add);             //传地址
 238   1              write_ds1302_byte(dat);             //传数据
 239   1              rst=0;                                                  //不受其他影响
 240   1              _nop_();
C51 COMPILER V9.01   DS1302                                                                04/09/2016 03:11:15 PAGE 5   

 241   1              io=1;                                              //释放
 242   1              sck=1;
 243   1      }
 244          
 245          uchar read_ds1302(uchar add)
 246          {
 247   1              uchar i,value;
 248   1              rst=0;
 249   1              _nop_();  //CPU原地踏步
 250   1              sck=0;
 251   1              _nop_();
 252   1              rst=1;
 253   1              _nop_();
 254   1              write_ds1302_byte(add);
 255   1              for(i=0;i<8;i++)
 256   1              {
 257   2                      value=value>>1;
 258   2                      sck=0;
 259   2                      if(io)
 260   2                      value=value|0x80;
 261   2                      sck=1;
 262   2              }
 263   1              rst=0;
 264   1              _nop_();
 265   1              sck=0;
 266   1              _nop_();
 267   1              sck=1;
 268   1              io=1;
 269   1              return value;
 270   1      }
