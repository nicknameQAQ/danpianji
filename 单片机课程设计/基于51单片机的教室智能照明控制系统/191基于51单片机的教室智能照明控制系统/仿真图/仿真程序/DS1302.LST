 272          void set_rtc()                            //设置时间
 273          {
 274   1              uchar i,j;
 275   1              for(i=0;i<7;i++)                         //转换BCD码
 276   1              {
 277   2                      j=time_data[i]/10;
 278   2                      time_data[i]=time_data[i]%10;
 279   2                      time_data[i]=time_data[i]+j*16;
 280   2              }
 281   1              write_ds1302(0x8e,0x00);          //去除写保护
 282   1              for(i=0;i<7;i++)
 283   1              {
 284   2                      write_ds1302(write_add[i],time_data[i]);
 285   2              }
 286   1              write_ds1302(0x8e,0x80);      //加写保护
 287   1      }
 288          
 289          void read_rtc()
 290          {
 291   1              uchar i;
 292   1              for(i=0;i<7;i++)
 293   1              {
 294   2                      time_data[i]=read_ds1302(read_add[i]);  //最终读出来的数 16进制
 295   2              }
 296   1      }
