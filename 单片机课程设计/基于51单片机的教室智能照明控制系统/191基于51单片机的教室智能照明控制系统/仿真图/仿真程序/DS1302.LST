 179          void LCD_Display_String(unsigned char line,unsigned char *string)
 180          {                                                                               //液晶屏显示内容，把要显示的内容写到对应的位置
 181   1              unsigned char i;
 182   1              unsigned char address=0;
 183   1              if(line==1)
 184   1              {
 185   2                      address=0x80;                                   //0X80是第1行的第1个位置  ,0x81第2位
 186   2              }
 187   1              else if(line==2)
 188   1              {
 189   2                      address=0x80+0x40;                      //0X80+0x40是第2行的第1个位置  ,0X80+0x40+1是第2行第2位
 190   2              }
 191   1              
 192   1              for(i=0;i<16;i++)
 193   1              {
 194   2                      write_com(address);
 195   2                      write_date(string[i]);
 196   2                      address++;
 197   2              } 
 198   1      }
 199          /**********************************DS1302时钟***************************************/
 200          void Time_Display(void)
 201          {
 202   1              read_rtc();
 203   1              Date_dispaly(0x80+0x40+9,time_data[6]);  //显示秒
 204   1              Date_dispaly(0x80+0x40+6,time_data[5]);  //显示分
 205   1              Date_dispaly(0x80+0x40+3,time_data[4]);  //显示时
 206   1              Date_dispaly(0x80+11,time_data[3]);              //显示日
 207   1              Date_dispaly(0x80+8,time_data[2]);               //显示月
 208   1              Week_dispaly(0x80+0x40+15,time_data[1]); //显示周
 209   1              Date_dispaly(0x80+5,time_data[0]);               //显示年
 210   1                                                 //   Year/10*16+Year%10
 211   1              Hour=time_data[4]/16*10+time_data[4]%16;;
 212   1              Minute=time_data[5]/16*10+time_data[5]%16;;
 213   1              Second=time_data[6]/16*10+time_data[6]%16;;
 214   1      }
