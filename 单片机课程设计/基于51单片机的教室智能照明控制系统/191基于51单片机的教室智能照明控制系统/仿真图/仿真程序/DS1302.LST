 983          void ds18b20_init()                                 //初始化函数
C51 COMPILER V9.01   DS1302                                                                04/09/2016 03:11:15 PAGE 17  

 984          {
 985   1              uint n;
 986   1              DQ=1;
 987   1              delay(8);                                          
 988   1              DQ=0;
 989   1              delay(80);                                          //低电平480——960us
 990   1              DQ=1;                                                   //总线释放
 991   1              delay(8);                                           //等待50——100us
 992   1              n=DQ;                                               //读取复位状态
 993   1              delay(4);
 994   1      }
 995          
 996          int readtemperature()                           //读整数部分
 997          {       
 998   1          int a,b;                                            //高八位，低八位
 999   1              ds18b20_init();
1000   1              write_byte(0xcc);                           //跳过rom匹配，跳过读序列号的操作，可节省操作时间
1001   1              write_byte(0x44);                           //启动温度检测
1002   1              delay(300);                                         //测温度
1003   1              ds18b20_init();                             //开始操作前需要复位
1004   1              write_byte(0xcc);                               //跳过rom匹配
1005   1              write_byte(0xbe);                           //写读寄存器中温度值的命令
1006   1              a=read_byte();                              //low         低位开始读取
1007   1              b=read_byte();                              //high        高位开始读取
1008   1              b<<=8;                                                  //把高位左移八位
1009   1              b=b|a;                                                  //高八位与第八位进行或运算，得到总和
1010   1              if(b>=0)                                                //如果温度大于等于0
1011   1              {
1012   2                      b=b*0.0625;                                     //直接乘以0.0625
1013   2                      write_com(0x80+0x40+2);         //在LCD1602对应的位置不写内容
1014   2                      write_date(0x20);
1015   2              }
1016   1          else                                                        //温度小于0
1017   1              {       
1018   2                      b=~b+1;                                         //取反码再加一
1019   2                      b=b*0.0625;                                     //再运算
1020   2                      write_com(0x80+0x40+2);         //在LCD1602对应的位置写一个负号
1021   2                      write_date(0x2d);
1022   2              }
1023   1              return b;                                               //返回b，此时以表示温度
1024   1      }
1025          void temperature_dispaly(char add,char dat)                     //温度显示函数：第一个：参数的地址，第二个：参数的内容
1026          {
1027   1              uchar shi,ge;
1028   1              shi=dat/10;                                                                             //把温度的十位提取出来
1029   1              ge=dat%10;                                                                              //把温度的个位提取出来
1030   1              write_com(0x80+0x40+add);                                               //要写的地址
1031   1              write_date(0x30+shi);                                                   //十位的内容   1602字符库
1032   1              write_date(0x30+ge);                                            //个位的内容    1602字符库
1033   1      }
