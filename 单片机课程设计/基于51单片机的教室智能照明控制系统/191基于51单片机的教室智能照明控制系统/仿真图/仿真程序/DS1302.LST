 131          void SetTime_dispaly(uchar add,uchar dat)        //第一个：参数的地址，第二个：参数的内容
 132          {
 133   1              uchar shi,ge;
 134   1              shi=dat/10;                                                     //把十位提取出来
 135   1              ge=dat%10;                                                      //把个位提取出来
 136   1              write_com(add);                                         //要写的地址
 137   1              write_date(0x30+shi);                           //十位的内容   1602字符库
 138   1              write_date(0x30+ge);                            //个位的内容   1602字符库
 139   1      }
 140          
 141          void Week_dispaly(uchar add,uchar dat)  //第一个：参数的地址，第二个：参数的内容
 142          {
 143   1              write_com(add);                                         //要写的地址
 144   1              write_date(0x30+dat);                           //十位的内容   1602字符库
 145   1      }
 146          void Date_dispaly(uchar add,uchar dat)   //第一个：参数的地址，第二个：参数的内容
 147          {
 148   1              uchar shi,ge;
 149   1              shi=dat/16;                                                     //把十位提取出来
 150   1              ge=dat%16;                                                      //把个位提取出来
 151   1              write_com(add+3);                                       //要写的地址
 152   1              write_date(0x30+shi);                           //十位的内容   1602字符库
 153   1              write_date(0x30+ge);                            //个位的内容   1602字符库                                  
 154   1      }
