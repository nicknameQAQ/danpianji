  57          /***********************18b20初始化函数*****************************/
  58          void init_18b20()
  59          {
  60   1              bit q;
  61   1              dq = 1;                         //把总线拿高
  62   1              delay_uint(1);      //15us
  63   1              dq = 0;                         //给复位脉冲
  64   1              delay_uint(80);         //750us
  65   1              dq = 1;                         //把总线拿高 等待
  66   1              delay_uint(10);         //110us
  67   1              q = dq;                         //读取18b20初始化信号
  68   1              delay_uint(20);         //200us
  69   1              dq = 1;                         //把总线拿高 释放总线
  70   1      }
  71          
  72          /*************写18b20内的数据***************/
  73          void write_18b20(uchar dat)
  74          {
  75   1              uchar i;
  76   1              for(i=0;i<8;i++)
  77   1              {                                        //写数据是低位开始
  78   2                      dq = 0;                  //把总线拿低写时间隙开始 
  79   2                      dq = dat & 0x01; //向18b20总线写数据了
  80   2                      delay_uint(5);   // 60us
  81   2                      dq = 1;                  //释放总线
  82   2                      dat >>= 1;
  83   2              }       
  84   1      }
  85          
  86          /*************读取18b20内的数据***************/
  87          uchar read_18b20()
  88          {
  89   1              uchar i,value;
  90   1              for(i=0;i<8;i++)
  91   1              {
  92   2                      dq = 0;                  //把总线拿低读时间隙开始 
  93   2                      value >>= 1;     //读数据是低位开始
  94   2                      dq = 1;                  //释放总线
  95   2                      if(dq == 1)              //开始读写数据 
  96   2                              value |= 0x80;
  97   2                      delay_uint(5);   //60us 读一个时间隙最少要保持60us的时间
  98   2              }
  99   1              return value;            //返回数据
 100   1      }
