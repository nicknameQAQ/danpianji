 102          /*************读取温度的值 读出来的是小数***************/
 103          uint read_temp()
 104          {
 105   1              uint value;
 106   1              uchar low;                         //在读取温度的时候如果中断的太频繁了，就应该把中断给关了，否则会影响到18b20的时序
 107   1              init_18b20();              //初始化18b20
 108   1              write_18b20(0xcc);         //跳过64位ROM
 109   1              write_18b20(0x44);         //启动一次温度转换命令
 110   1              delay_uint(50);            //500us
 111   1      
 112   1              init_18b20();              //初始化18b20
 113   1              
 114   1              write_18b20(0xcc);         //跳过64位ROM
 115   1              write_18b20(0xbe);         //发出读取暂存器命令
 116   1              
 117   1              low = read_18b20();        //读温度低字节
C51 COMPILER V9.01   蝊控风扇_数_牍_显示                                                   05/16/2015 22:36:13 PAGE 3   

 118   1              value = read_18b20();  //读温度高字节
 119   1              value <<= 8;               //把温度的高位左移8位
 120   1              value |= low;              //把读出的温度低位放到value的低八位中
 121   1              value *= 0.625;        //转换到温度值 小数
 122   1              return value;              //返回读出的温度 带小数
 123   1      }
