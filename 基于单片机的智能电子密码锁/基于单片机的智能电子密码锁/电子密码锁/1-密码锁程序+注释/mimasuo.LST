 307          //=====================按键检测并返回按键值===============================
 308          unsigned char keynum(void)
 309          {
 310   1              unsigned char row,col,i;
 311   1              P1=0xf0;
 312   1              if((P1&0xf0)!=0xf0)
 313   1              {
 314   2                      Delay5Ms();
 315   2              Delay5Ms();
 316   2                      if((P1&0xf0)!=0xf0)
 317   2                      {
 318   3                      row=P1^0xf0;          //确定行线
 319   3                              i=0;
 320   3                              P1=a[i];                  //精确定位
 321   3                              while(i<4)
 322   3                              {
 323   4                                      if((P1&0xf0)!=0xf0)
 324   4                                      {
 325   5                                              col=~(P1&0xff);   //确定列线
 326   5                                              break;            //已定位后提前退出   
 327   5                                      }
 328   4                                      else 
 329   4                                      {
 330   5                                              i++;
 331   5                                              P1=a[i];
 332   5                                      }
 333   4                              }
 334   3                      }
 335   2                      else 
 336   2                      {
 337   3                              return 0;
 338   3                      }
 339   2                      while((P1&0xf0)!=0xf0);
 340   2                      return (row|col);                       //行线与列线组合后返回
 341   2              }
 342   1              else return 0;                          //无键按下时返回0
 343   1      }
