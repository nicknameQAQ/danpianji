 190          void WrToROM(uchar Data[],uchar Address,uchar Num)
 191          {
 192   1        uchar i;
 193   1        uchar *PData;
 194   1        PData=Data;
 195   1        for(i=0;i<Num;i++)
 196   1        {
 197   2        Start();
 198   2        Send(0xa0);
 199   2        Ack();
 200   2        Send(Address+i);
 201   2        Ack();
 202   2        Send(*(PData+i));
 203   2        Ack();
 204   2        Stop();
 205   2        mDelay(20);
 206   2        }
 207   1      }
 208          
 209          void RdFromROM(uchar Data[],uchar Address,uchar Num)
 210          {
 211   1        uchar i;
 212   1        uchar *PData;
 213   1        PData=Data;
 214   1        for(i=0;i<Num;i++)
 215   1        {
 216   2        Start();
 217   2        Send(0xa0);
 218   2        Ack();
 219   2        Send(Address+i);
 220   2        Ack();
 221   2        Start();
 222   2        Send(0xa1);
 223   2        Ack();
 224   2        *(PData+i)=Read();
 225   2        Scl=0;
 226   2        NoAck();
 227   2        Stop();
 228   2        }
 229   1      }
