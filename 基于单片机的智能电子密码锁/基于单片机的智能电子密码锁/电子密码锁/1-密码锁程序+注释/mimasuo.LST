 139           /*发送数据子程序，Data为要求发送的数据*/
 140          void Send(uchar Data)
 141          {
 142   1              uchar BitCounter=8;
 143   1              uchar temp;
 144   1              do
 145   1              {
 146   2                      temp=Data;                                         //将待发送数据暂存temp
 147   2                      Scl=0;
 148   2                      Nop();
 149   2                      if((temp&0x80)==0x80)              //将读到的数据&0x80
 150   2                      Sda=1;
 151   2                      else 
 152   2                      Sda=0;
 153   2                      Scl=1;
 154   2                      temp=Data<<1;                              //数据左移
 155   2                      Data=temp;                                         //数据左移后重新赋值Data
 156   2                      BitCounter--;                              //该变量减到0时，数据也就传送完成了
 157   2              }
 158   1              while(BitCounter);                                 //判断是否传送完成
 159   1              Scl=0;
 160   1      }
 161          
 162          /*读一字节的数据，并返回该字节值*/
 163          uchar Read(void)
 164          {
 165   1          uchar temp=0;
 166   1              uchar temp1=0;
 167   1              uchar BitCounter=8;
 168   1              Sda=1;
 169   1              do
 170   1              {
 171   2                      Scl=0;
 172   2                      Nop();
 173   2                      Scl=1;
 174   2                      Nop();
 175   2                      if(Sda)                            //数据位是否为1
 176   2                              temp=temp|0x01;    //为1 temp的最低位为1（|0x01，就是将最低位变为1）
 177   2                      else                               //如果为0
 178   2                              temp=temp&0xfe;    //temp最低位为0（&0xfe（11111110）最低位就是0）
 179   2                      if(BitCounter-1)           //BitCounter减1后是否为真
C51 COMPILER V9.00   MIMASUO                                                               08/02/2017 20:53:05 PAGE 4   

 180   2                      {
 181   3                              temp1=temp<<1;     //temp左移
 182   3                              temp=temp1;
 183   3                      }
 184   2                      BitCounter--;              //BitCounter减到0时，数据就接收完了
 185   2              }
 186   1              while(BitCounter);                 //判断是否接收完成
 187   1              return(temp);
 188   1      }
