 222          /*******************************************************************************
 223          * 函 数 名         : KeyDown
 224          * 函数功能                 : 检测有按键按下并读取键值
 225          * 输    入         : 无
 226          * 输    出         : 无
 227          *******************************************************************************/
 228          void KeyDown(void)
 229          { 
 230   1              unsigned char a=0;
 231   1                       
 232   1              KeyValue=66;
 233   1              GPIO_KEY=0x0f;
 234   1              if(GPIO_KEY!=0x0f)//读取按键是否按下
 235   1              {
 236   2                      Lcd1602_Delay1ms(10); //延时10ms进行消抖
 237   2                      if(GPIO_KEY!=0x0f)    //再次检测键盘是否按下
 238   2                      {               
 239   3                              //测试列
 240   3                              GPIO_KEY=0X0F;
 241   3                              switch(GPIO_KEY)
C51 COMPILER V9.00   MAIN                                                                  06/08/2019 17:59:56 PAGE 5   

 242   3                              {
 243   4                                      case(0X07):     KeyValue=0;break;
 244   4                                      case(0X0b):     KeyValue=1;break;
 245   4                                      case(0X0d): KeyValue=2;break;
 246   4                                      case(0X0e):     KeyValue=3;break;
