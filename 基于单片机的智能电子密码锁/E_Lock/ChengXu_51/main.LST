 267          /*******************************************************************************
 268          * 函数名         : void At24c02Write(unsigned char addr,unsigned char dat)
 269          * 函数功能                 : 往24c02的一个地址写入一个数据
 270          * 输入           : 无
 271          * 输出           : 无
 272          *******************************************************************************/
 273          void At24c02Write(unsigned char addr,unsigned char dat)
 274          {
 275   1              I2cStart();
 276   1              I2cSendByte(0xa0);//发送写器件地址
 277   1              I2cSendByte(addr);//发送要写入内存地址
 278   1              I2cSendByte(dat);       //发送数据
 279   1              I2cStop();
 280   1      }
 281          /*******************************************************************************
 282          * 函数名         : unsigned char At24c02Read(unsigned char addr)
 283          * 函数功能                 : 读取24c02的一个地址的一个数据
 284          * 输入           : 无
 285          * 输出           : 无
 286          *******************************************************************************/
 287          unsigned char At24c02Read(unsigned char addr)
 288          {
 289   1              unsigned char num;
 290   1              I2cStart();
 291   1              I2cSendByte(0xa0); //发送写器件地址
 292   1              I2cSendByte(addr); //发送要读取的地址
 293   1              I2cStart();
 294   1              I2cSendByte(0xa1); //发送读器件地址
 295   1              num=I2cReadByte(); //读取数据
 296   1              I2cStop();
 297   1              return num;     
 298   1      }
