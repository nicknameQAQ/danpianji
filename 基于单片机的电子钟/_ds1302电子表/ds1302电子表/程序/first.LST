 891          int ds18b20_read_temp(){
 892   1              //读取温度
 893   1              uchar low;
 894   1              uchar high;
 895   1              unsigned long tmp;
 896   1              float value;
 897   1              int t;//温度
 898   1              ds18b20_init();
