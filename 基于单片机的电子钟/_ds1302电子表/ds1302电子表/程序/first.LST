 864          uchar ds18b20_read(){
 865   1              //读一个字节
 866   1              uchar i=0;
 867   1              uchar dat = 0;
 868   1              for (i=8;i>0;i--)
 869   1              {
 870   2                      dq = 0; // 给脉冲信号
 871   2                      dat>>=1;
 872   2                      dq = 1; // 给脉冲信号
 873   2                      if(dq)
 874   2                              dat|=0x80;
 875   2                      delay1(4);
 876   2              }
 877   1              return(dat);
 878   1      }
