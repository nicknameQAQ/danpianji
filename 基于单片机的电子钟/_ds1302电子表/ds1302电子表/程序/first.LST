 911   1              if(tmp>=63488){//ffff f000 0000 0000-->(f800)
 912   2                      temp_flag=0;
 913   2                      //8位全为1时，加1才进位
 914   2                      if((~low)==0xff){//判断low取反加1之后是否进位
 915   3                              high=(~high)+1;
 916   3                              low=0;
