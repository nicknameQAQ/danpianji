 900   1              ds18b20_write(0x44); //启动温度转换
 901   1              ds18b20_init();
 902   1              ds18b20_write(0xCC); //跳过读序列号的操作
 903   1              ds18b20_write(0xBE); //读取温度寄存器  共九个  前两个代表温度
 904   1              low=ds18b20_read();//低八位数据
 905   1              high=ds18b20_read();//高八位数据
 906   1      
