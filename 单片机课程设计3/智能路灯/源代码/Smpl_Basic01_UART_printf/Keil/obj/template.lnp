--cpu Cortex-M4.fp
".\obj\system_m451series.o"
".\obj\startup_m451series.o"
".\obj\main.o"
".\obj\nuadc.o"
".\obj\nuclk.o"
".\obj\nugpio.o"
".\obj\nuuart.o"
".\obj\clk.o"
".\obj\eadc.o"
".\obj\gpio.o"
".\obj\retarget.o"
".\obj\sys.o"
".\obj\timer.o"
".\obj\uart.o"
--ro-base 0x00000000 --entry 0x00000000 --rw-base 0x20000000 --entry Reset_Handler --first __Vectors
--feedback ".\obj\template.fed" --feedback_image=none
--strict
--map --first='startup_M451Series.o(RESET)' --datacompressor=off --info=inline --entry Reset_Handler --summary_stderr --info summarysizes --map --symbols
--info sizes --info totals
--list ".\lst\template.map" -o .\obj\template.axf