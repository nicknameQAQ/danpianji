 317          void LCD_WriteData(uchar LCD_1602_DATA)  /********LCD1602数据写入***********/
 318          {
 319   1       delay5ms();  //操作前短暂延时，保证信号稳定
 320   1       LCD_E=0;
 321   1       LCD_RS=1;
 322   1       LCD_RW=0;
 323   1       _nop_();
 324   1       LCD_E=1;
 325   1       LCD_DATA=LCD_1602_DATA;
 326   1       LCD_E=0;
 327   1       LCD_RS=0;
 328   1      }
