 301          /**在指定地址显示指定数量的指定字符**/
 302          /**Adress_Com显示地址，Num_Adat显示字符数量，Adress_Data显示字符串内容**/ 
 303          void lcd_1602_word(uchar Adress_Com,uchar Num_Adat,uchar *Adress_Data)
 304          {
 305   1       uchar a=0;
 306   1       uchar Data_Word;
 307   1       LCD_WriteCom(Adress_Com); //选中地址
 308   1       for(a=0;a<Num_Adat;a++)   //for循环决定显示字符个数
 309   1        {
 310   2         Data_Word=*Adress_Data;        //读取字符串数据
 311   2         LCD_WriteData(Data_Word);  //显示字符串
 312   2         Adress_Data++;                         //显示地址加一
 313   2        }
 314   1      }
