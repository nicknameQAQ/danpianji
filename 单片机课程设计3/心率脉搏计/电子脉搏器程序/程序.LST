 336   1       LCD_RW=0;
 337   1       _nop_();
 338   1       LCD_E=1;
 339   1       LCD_DATA=LCD_1602_COM;
 340   1       LCD_E=0;
 341   1       LCD_RS=0;
 342   1      }
