 273          /**定时器T0工作函数**/
 274          void Time0() interrupt 1
 275          {
 276   1       TH0=0xfc;                 //1ms
 277   1       TL0=0x18;                 //重新赋初值
 278   1       Xintiao_Jishu++;  //心跳计数加
 279   1       if(Xintiao_Jishu==5000)//心跳计数大于5000
 280   1        {
 281   2         Xintiao_Jishu=0;             //数据清零
 282   2         View_Change=1;               //显示位置1
 283   2         Xintiao_Change=0;    //置零，准备再次检测
 284   2         stop=1;         //心跳计数超过5000后说明心率不正常或者没有测出，stop置1
 285   2         speaker=1;  //关闭蜂鸣器
 286   2        }
 287   1      }
