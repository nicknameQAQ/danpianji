 441          void write_byte(uchar dat)//写一个字节
 442          {
 443   1              uchar i;
 444   1              for(i=0;i<8;i++)//一次写一位，一个字节循环8次
 445   1              {
 446   2                      DS = 0;
 447   2                      _nop_();//产生写时序（15US内满足要求）
 448   2                      DS = dat&0X01; //与
 449   2                      delayus(9);//延时大于60US 9*6.5+11.95=70.45us 同时满足写0写1
 450   2                      DS = 1;//释放总线
 451   2                      _nop_();
 452   2                      dat>>=1;//右移一位
 453   2              }
 454   1      }
 455          
 456          uchar read_byte()//读一个字节
 457          {
 458   1              uchar i,j,dat;
 459   1              for(i=0;i<8;i++)
 460   1              {
 461   2                      DS = 0;
 462   2                      _nop_();//产生读时序
 463   2                      DS = 1;
 464   2                      _nop_();//释放总线
 465   2                      j = DS;
 466   2                      delayus(9);//读取数据大于60US 9*6.5+11.95=70.45us
 467   2                      DS = 1;
 468   2                      _nop_();
 469   2                      dat = (j<<7)|(dat>>1);
 470   2              }
 471   1              return(dat);
 472   1      }
