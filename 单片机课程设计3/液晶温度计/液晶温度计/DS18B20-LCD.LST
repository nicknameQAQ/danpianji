 529          void wendu() //温度显示函数
 530          { 
 531   1        bit res;
 532   1        int temp;  //读取到的当前温度值
 533   1        
 534   1        unsigned char len;
 535   1      
 536   1                  Get18B20Temp(&temp);  //读取当前温度
 537   1                  res = Get18B20Temp(&temp);  //读取当前温度
 538   1                  if (res)                    //读取成功时，刷新当前温度显示
 539   1                  {           
 540   2                                  intT = temp >> 4;          //分离出温度值整数部分
 541   2                      decT = temp & 0xF;         //分离出温度值小数部分
 542   2                      len = IntToString(str_wd, intT); //整数部分转换为字符串
 543   2                      str_wd[len++] = '.';             //添加小数点
 544   2                      decT = (decT*10) / 16;        //二进制的小数部分转换为1位十进制位
 545   2                      str_wd[len++] = decT + '0';   //十进制小数位再转换为ASCII字符
 546   2                      str_wd[len] = '\0';              //添加字符串结束符
