 100   1              i = DS;
 101   1              delayus(20);//读取存在信号的时间20*6.5+11.95=141.95us
 102   1              DS = 1; //释放总线
 103   1              _nop_(); 
 104   1              return(i);//i=0代表DS18B20已经准备好了
 105   1      }
