  75   1              x |= 0x40;
  76   1              x |= 0x80;
  77   1              LCD_WRITE_CMD(x);
  78   1              while(*str != '\0')
  79   1              {
  80   2                      LCD_WRITE_DATE(*str++);
  81   2              }
  82   1      }
  83          void LCD_Init()  //     初始化
  84          {
  85   1              LCD_WRITE_CMD(0x38); // 设置16*2显示，5*7点阵，8位数据接口
