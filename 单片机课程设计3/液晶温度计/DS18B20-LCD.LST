  28          void delayus(uchar us)
  29          {
  30   1              while(us--);//us--要6.5us,进入一次函数11.95us;
  31   1      } //微秒延时    
  32          void LCD_READ_BUSY() //忙不忙
  33          {
  34   1              uchar busy;
  35   1              P0 = 0XFF;
  36   1              RS = 0;
  37   1              RW = 1;
  38   1              do
  39   1              {
  40   2                      EN = 1;
  41   2                      busy = P0;
  42   2                      EN = 0;
  43   2              }while(busy&0X80);
  44   1              EN = 1;
  45   1      }         
  46          void LCD_WRITE_CMD(uchar cmd)//写一个字节命令流程
  47          {
  48   1              LCD_READ_BUSY();//判断忙不忙
  49   1              RS = 0;
  50   1              RW = 0;
  51   1              P0 = cmd;
  52   1              EN = 1;
  53   1              EN = 0;
  54   1      }
