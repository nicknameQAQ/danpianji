 313          void write_byte(uchar dat)//写一个字节
 314          {
 315   1              uchar i;
 316   1              for(i=0;i<8;i++)//一次写一位，一个字节循环8次
 317   1              {
 318   2                      DS = 0;
 319   2                      _nop_();//产生写时序（15US内满足要求）
 320   2                      DS = dat&0X01; //与
 321   2                      delayus(9);//延时大于60US 9*6.5+11.95=70.45us 同时满足写0写1
 322   2                      DS = 1;//释放总线
 323   2                      _nop_();
 324   2                      dat>>=1;//右移一位
 325   2              }
 326   1      }
 327          
 328          uchar read_byte()//读一个字节
 329          {
 330   1              uchar i,j,dat;
 331   1              for(i=0;i<8;i++)
 332   1              {
 333   2                      DS = 0;
 334   2                      _nop_();//产生读时序
 335   2                      DS = 1;
 336   2                      _nop_();//释放总线
 337   2                      j = DS;
 338   2                      delayus(9);//读取数据大于60US 9*6.5+11.95=70.45us
 339   2                      DS = 1;
 340   2                      _nop_();
 341   2                      dat = (j<<7)|(dat>>1);
 342   2              }
 343   1              return(dat);
 344   1      }
 345          void beep(int m,gao,di)//按键与警报程序
 346          {       
 347   1              if(m>=gao)
 348   1              {
 349   2                      if(di<=gao)       //判断最低报警温度是否低于最高报警温度
 350   2                      {
 351   3                              BP = DD;
 352   3                              P1 = 0XEE+LL*0X11;
 353   3                      }
 354   2                      else if(di>gao)
 355   2                      {
 356   3                              BP = 1;
 357   3                              P1 = 0X7E+LL*0X81;
 358   3                      }
 359   2              }
 360   1              else if(m<=di) 
 361   1              {
 362   2                      if(di<=gao)       //判断最低报警温度是否低于最高报警温度
 363   2                      {
 364   3                              BP = DD;
 365   3                              P1=0X77+LL*0X88;
C51 COMPILER V9.01   DS18B20_LCD                                                           06/24/2020 16:23:43 PAGE 7   

 366   3                      }
 367   2                      else if(di>gao)
 368   2                      {
 369   3                              BP = 1;
 370   3                              P1 = 0X7E+LL*0X81;
 371   3                      }
 372   2      
 373   2              }
 374   1              else
 375   1              {
 376   2                      if(di<=gao)      //判断最低报警温度是否低于最高报警温度
 377   2                      {
 378   3                              BP = 1;
 379   3                              P1=0XBB+LL*0X44;
 380   3                      }
 381   2                      else if(di>gao)
 382   2                      {
 383   3                              BP = 1;
 384   3                              P1 = 0X7E+LL*0X81;
 385   3                      }
 386   2              }
 387   1      }
