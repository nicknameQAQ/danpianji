  65          /******************把数据保存到单片机内部eepom中******************/
  66          void write_eeprom()
  67          {
  68   1        
  69   1        SectorErase(0x2000);
  70   1        byte_write(0x2000, bj_shudu % 256);
  71   1        byte_write(0x2001, bj_shudu / 256);
  72   1        byte_write(0x2002, zong_lc % 256);
  73   1        byte_write(0x2003, zong_lc / 256 % 256);
  74   1        byte_write(0x2004, zong_lc / 256 / 256 % 256);
  75   1      
  76   1        byte_write(0x2055, a_a);  
  77   1      }
  78          
  79          /******************把数据从单片机内部eepom中读出来*****************/
  80          void read_eeprom()
  81          {
  82   1        uint value;
  83   1        bj_shudu  = byte_read(0x2001);
  84   1        bj_shudu <<= 8;
  85   1        bj_shudu  |= byte_read(0x2000);
  86   1        zong_lc  = byte_read(0x2004);
  87   1        zong_lc <<= 16;
  88   1        value  = byte_read(0x2003);
  89   1        zong_lc |= (value << 8);
  90   1        zong_lc  |= byte_read(0x2002);
  91   1        a_a     = byte_read(0x2055);
  92   1      }
  93          
  94          /**************开机初始化保存的数据*****************/
  95          void init_eeprom()   //开机初始化保存的数据*
  96          {
