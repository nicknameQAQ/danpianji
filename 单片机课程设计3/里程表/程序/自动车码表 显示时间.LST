 452          /***********计算速度函数**************/
 453          void menu_dis()   //计算速度函数
 454          {
 455   1        static uchar value,value1;
 456   1        if(menu_1 == 0)
 457   1        { 
 458   2          if(flag_1s == 1)   
 459   2          { 
 460   3            flag_1s = 0;    
 461   3            if(flag_en == 0)
 462   3            {
 463   4              value ++;
 464   4              if(value >= 3)  //2秒
 465   4              { 
 466   5                speed_km = 0;  //速度为0
 467   5                shudu = (uint)speed_km; 
 468   5                value = 0;        
 469   5              }
 470   4            }
 471   3            if((flag_en == 1))
 472   3            { 
 473   4              value = 0;    
 474   4              flag_en = 0;   
 475   4               //1s = 1 / 1000000us;    // 1m/s=0.001km除以1/3600h=3.6km/h      
 476   4              f_hz = 1000000 / (t2_num * 65536.0 + TH11 * 256 + TL11);  //算出来就是秒
 477   4              t2_num = 0; //把变量清零
 478   4              TH11 = 0;
 479   4              TL11 = 0;            
 480   4              speed_m = f_hz * zhijing * 3.14  ;  //算出来的是m/s
 481   4              juli_z = (juli_z + (uint)speed_m) ;        //总路程m  
 482   4              speed_km = speed_m * 3.6 ;  //(带个小数点) km/s   
 483   4                shudu = (uint)speed_km;
 484   4              if(shudu >= 99)
 485   4                shudu = 99;
 486   4              zong_lc += speed_m;
 487   4              value1++;
 488   4              if(value1 >= 20)
 489   4              {
C51 COMPILER V9.52.0.0   ___________________                                               05/04/2018 12:00:59 PAGE 9   

 490   5                value1 = 0;
 491   5                write_eeprom();
 492   5              }
 493   4            }   
 494   3      
 495   3            write_sfm2(1,3,shudu);    
 496   3            write_sfm4(2,3,juli_z); 
 497   3      
 498   3          }
 499   2        }
 500   1      }
