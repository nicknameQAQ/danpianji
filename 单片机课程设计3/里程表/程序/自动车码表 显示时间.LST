 502          /********************独立按键程序*****************/
 503          uchar key_can;   //按键值
 504          
 505          void key()   //独立按键程序
 506          {
 507   1        static uchar key_new;
 508   1        key_can = 20;                   //按键值还原
 509   1        P2 |= 0x78;                     //对应的按键IO口输出为1
