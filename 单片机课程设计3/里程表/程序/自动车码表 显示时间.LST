  98   1        if(a_a != 12)   //新的单片机初始单片机内问eeprom
  99   1        {
 100   2          bj_shudu = 50;
 101   2          a_a = 12;
 102   2          write_eeprom();    //保存数据
 103   2        } 
 104   1      }
