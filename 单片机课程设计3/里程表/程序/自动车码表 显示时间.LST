 400   2          i = 3;
 401   2          write_ds1302ram(30,i);
 402   2          write_ds1302(0x8e,0x00);              //打开写保护
 403   2          for(i=0;i<7;i++)
 404   2            write_ds1302(write_add[i],init_ds[i]);  //把最高位值0 允许ds1302工作
 405   2          write_ds1302(0x8e,0x80);  //关写保护
 406   2        }
 407   1        write_sfm2(1,0,i);
 408   1      }
