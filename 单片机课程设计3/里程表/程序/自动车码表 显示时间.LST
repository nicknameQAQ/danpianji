 289          
 290          /*************写一个数据到对应的地址里***************/
 291          void write_ds1302(uchar add,uchar dat)
 292          {   
 293   1        rst = 1;       //把复位线拿高
 294   1        for(i=0;i<8;i++)
 295   1        {            //低位在前
 296   2          clk = 0;     //时钟线拿低开始写数据
 297   2          io = add & 0x01;      
 298   2          add >>= 1;     //把地址右移一位
 299   2          clk = 1;     //时钟线拿高
 300   2        } 
 301   1        for(i=0;i<8;i++)
 302   1        {
 303   2          clk = 0;     //时钟线拿低开始写数据
C51 COMPILER V9.52.0.0   ___________________                                               05/04/2018 12:00:59 PAGE 6   

 304   2          io = dat & 0x01;
 305   2          dat >>= 1;     //把数据右移一位
 306   2          clk = 1;     //时钟线拿高
 307   2        }
 308   1        rst = 0;       //复位线合低
 309   1        clk = 0;
 310   1        io = 0;
 311   1      }
 312          
 313          /*************从对应的地址读一个数据出来***************/
 314          uchar read_ds1302(uchar add)
 315          {
 316   1        uchar value,i;
 317   1        rst = 1;       //把复位线拿高
 318   1        for(i=0;i<8;i++)
 319   1        {            //低位在前
 320   2          clk = 0;     //时钟线拿低开始写数据
 321   2          io = add & 0x01;      
 322   2          add >>= 1;     //把地址右移一位
 323   2          clk = 1;     //时钟线拿高
 324   2        }   
 325   1        for(i=0;i<8;i++)
 326   1        {
 327   2          clk = 0;     //时钟线拿低开始读数据
 328   2          value >>= 1;
 329   2          if(io == 1)
 330   2            value |= 0x80;
 331   2          clk = 1;     //时钟线拿高
 332   2        }
 333   1        rst = 0;       //复位线合低
 334   1        clk = 0;
 335   1        io = 0;
 336   1        return value;    //返回读出来的数据
 337   1      }
