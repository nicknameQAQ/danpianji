 353          /*************把要写的时间 年月日 都写入ds1302里***************/
 354          void write_time()
 355          {
 356   1        write_ds1302(0x8e,0x00);      //打开写保护
 357   1        write_ds1302(write_add[0],miao);  //写秒
 358   1        write_ds1302(write_add[1],fen);   //写分
 359   1        write_ds1302(write_add[2],shi);   //写时
 360   1        write_ds1302(write_add[3],ri);    //写日
 361   1        write_ds1302(write_add[4],yue);   //写月
 362   1        write_ds1302(write_add[5],nian);  //写星期
 363   1        write_ds1302(write_add[6],week);  //写年
 364   1        write_ds1302(0x8e,0x80);      //关闭写保护
 365   1      }
