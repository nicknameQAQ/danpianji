 366          
 367          /*************把数据保存到ds1302 RAM中**0-31*************/
 368          void write_ds1302ram(uchar add,uchar dat)
 369          {
 370   1        add <<= 1;     //地址是从第二位开始的
 371   1        add &= 0xfe;   //把最低位清零  是写的命令
 372   1        add |= 0xc0;   //地址最高两位为 1  
 373   1        write_ds1302(0x8e,0x00);
 374   1        write_ds1302(add,dat);  
 375   1        write_ds1302(0x8e,0x80);
 376   1      }
 377          
 378          /*************把数据从ds1302 RAM读出来**0-31*************/
 379          uchar read_ds1302ram(uchar add)
 380          {
 381   1        add <<= 1;     //地址是从第二位开始的
 382   1        add |= 0x01;   //把最高位置1  是读命令
 383   1        add |= 0xc0;   //地址最高两位为 1  
 384   1        return(read_ds1302(add)); 
 385   1      }
