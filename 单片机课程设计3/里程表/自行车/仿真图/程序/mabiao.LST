   1          #include<reg52.h>
   2          
   3          #define uchar unsigned char
   4          #define uint unsigned int
   5          
   6          sbit COUNT_IN=P3^2;
   7          
   8          //定义1602相关管脚
   9          sbit rs=P2^7;
  10          sbit en=P2^6;
  11          
  12          uint count;
  13          unsigned long Velocity,Mileage;
  14          bit flag;
  15          uchar code tab1[]={"  Speed:      km/h"};       
  16          uchar code tab2[]={"Mileage:  .   km"}; 
  17          
  18          void delay(uint x)
  19          {
  20   1              uint i,j;
  21   1              for(i=0;i<x;i++)
  22   1              for(j=0;j<110;j++);
  23   1      }
  24          void init()
  25          {
  26   1              IT0=1;  //INT0负跳变触发        
  27   1          TMOD=0x01;//定时器工作于方式1
  28   1              TH0=0x3c;         //50ms
  29   1              TL0=0xb0;
  30   1              EA=1; //CPU开中断总允许
  31   1              ET0=1;//开定时中断
  32   1              EX0=1;//开外部INTO中断
  33   1          TR0=1;//启动定时
  34   1      }
  35          /********液晶写入指令函数与写入数据函数，以后可调用**************/
  36          
  37          void write_1602com(uchar com)//****液晶写入指令函数****
  38          {
  39   1              rs=0;//数据/指令选择置为指令
  40   1              P0=com;//送入数据
  41   1              delay(1);
  42   1              en=1;//拉高使能端，为制造有效的下降沿做准备
  43   1              delay(1);
  44   1              en=0;//en由高变低，产生下降沿，液晶执行命令
  45   1      
  46   1      }
  47          
  48          
  49          void write_1602dat(uchar dat)//***液晶写入数据函数****
  50          {
  51   1              rs=1;//数据/指令选择置为数据
  52   1              P0=dat;//送入数据
  53   1              delay(1);
  54   1              en=1; //en置高电平，为制造下降沿做准备
  55   1              delay(1);
C51 COMPILER V9.00   MABIAO                                                                05/06/2017 21:45:50 PAGE 2   

  56   1              en=0; //en由高变低，产生下降沿，液晶执行命令
  57   1      }
  58          
  59          
  60          void lcd_init()//***液晶初始化函数****
  61          {
  62   1              uchar a;
  63   1              write_1602com(0x38);//设置液晶工作模式，意思：16*2行显示，5*7点阵，8位数据
  64   1              write_1602com(0x0c);//开显示不显示光标
  65   1              write_1602com(0x06);//整屏不移动，光标自动右移
  66   1              write_1602com(0x01);//清显示
  67   1      
  68   1              write_1602com(0x80);//显示固定符号从第一行第1个位置之后开始显示
  69   1              for(a=0;a<16;a++)
  70   1              {
  71   2                      write_1602dat(tab1[a]);//向液晶屏写固定符号部分
  72   2              }
  73   1              write_1602com(0x80+0x40);//显示固定符号写入位置，从第2个位置后开始显示
  74   1              for(a=0;a<16;a++)
  75   1              {
  76   2                      write_1602dat(tab2[a]);//写显示固定符号
  77   2              }
  78   1      }
  79          
  80          void display()
  81          {
  82   1                      //                      1km/h=100m/0.1h          360s
  83   1                      //                      10km/h=100m/0.01h        36s
  84   1                      //                      100km/h=100m/0.001h  3.6s
  85   1      
  86   1                      write_1602com(0x80+9);
  87   1                      if(Velocity/100==0)
  88   1                      write_1602dat(' ');
  89   1                      else
  90   1                      write_1602dat(0x30+Velocity/100);
  91   1                      if((Velocity/100+Velocity%100/10)==0)
  92   1                      write_1602dat(' ');
  93   1                      else
  94   1                      write_1602dat(0x30+Velocity%100/10);
  95   1                      write_1602dat(0x30+Velocity%10);//数字+30得到该数字的LCD1602显示码
  96   1      
  97   1                      write_1602com(0x80+0x40+8);
  98   1                      write_1602dat(0x30+Mileage/1000000);//数字+30得到该数字的LCD1602显示码
  99   1                      write_1602dat(0x30+Mileage%1000000/100000);//数字+30得到该数字的LCD1602显示码 
 100   1                      write_1602com(0x80+0x40+11);
 101   1                      write_1602dat(0x30+Mileage%100000/10000);//数字+30得到该数字的LCD1602显示码
 102   1                      write_1602dat(0x30+Mileage%10000/1000);//数字+30得到该数字的LCD1602显示码
 103   1                      
 104   1                      write_1602dat(0x30+Mileage%1000/100);//数字+30得到该数字的LCD1602显示码
 105   1      }
 106          
 107          void main()
 108          {
 109   1              init();
 110   1              lcd_init();
 111   1              while(1)
 112   1              {
 113   2                      display();
 114   2              }
 115   1      }
 116          
