 121          
 122          void time0() interrupt 1
 123          {
 124   1              uchar m;
 125   1              TH0=0x3c;
 126   1              TL0=0xb0;        //50ms
 127   1              m++;
 128   1              if(m>=10)
 129   1              {
 130   2                      m=0;
 131   2                      Mileage=Mileage+Velocity*500/36;                 //里程m=速度km/h*1000*5/3.6
 132   2                      Velocity=count/5;//将100ms内的脉冲数
 133   2                      count=0;                
 134   2              }
 135   1      }
