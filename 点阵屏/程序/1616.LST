 245          /* 将每行数据送至74HC595        
 246           * m为高8位,n为低8位
 247           * SH为移位时钟，ST为锁存时钟 */
 248          void senddata(u8 m,u8 n)
 249          {
 250   1              u8 i;
 251   1              ST=0;
 252   1              for(i=0;i<16;i++)
 253   1              {
 254   2                      SH=0;
 255   2                      if(i<8)
 256   2                        {
 257   3                              DS=0X80&(m<<i);    
 258   3                        }
 259   2                      else
 260   2                              DS=0X80&(n<<(i-8));
 261   2                      SH=1;   
 262   2              }
 263   1              ST=1;
 264   1      }
 265          
 266          void delay(u8 m)
 267          {
 268   1              u8 j;
 269   1              for(j=m;j>0;j--);
 270   1      }


