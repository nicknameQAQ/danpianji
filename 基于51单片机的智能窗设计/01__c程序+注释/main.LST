 358          /*********************************************************/
 359          uchar Get_ADC0832()
 360          { 
 361   1        uchar i;
 362   1        uchar dat1=0;
 363   1        uchar dat2=0;
 364   1        
 365   1        ADC_CLK = 0;        // 电平初始化
C51 COMPILER V9.52.0.0   MAIN                                                              10/11/2018 15:00:28 PAGE 7   

 366   1        ADC_DAT = 1;
 367   1        _nop_();
 368   1        ADC_CS = 0;
 369   1        WavePlus();         // 起始信号 
 370   1        ADC_DAT = 1;
 371   1        WavePlus();         // 通道选择的第一位
 372   1        ADC_DAT = 0;      
 373   1        WavePlus();         // 通道选择的第二位
 374   1        ADC_DAT = 1;
 375   1        
 376   1        for(i=0;i<8;i++)    // 第一次读取
 377   1        {
 378   2          dat1<<=1;
 379   2          WavePlus();
 380   2          if(ADC_DAT)
 381   2            dat1=dat1|0x01;
 382   2          else
 383   2            dat1=dat1|0x00;
 384   2        }
 385   1        
 386   1        for(i=0;i<8;i++)    // 第二次读取
 387   1        {
 388   2          dat2>>= 1;
 389   2          if(ADC_DAT)
 390   2            dat2=dat2|0x80;
 391   2          else
 392   2            dat2=dat2|0x00;
 393   2          WavePlus();
 394   2        }
 395   1        
 396   1        _nop_();            // 结束此次传输
 397   1        ADC_DAT = 1;
 398   1        ADC_CLK = 1;
 399   1        ADC_CS  = 1;   
 400   1      
 401   1        if(dat1==dat2)      // 返回采集结果
 402   1          return dat1;
 403   1        else
 404   1          return 0;
 405   1      } 
