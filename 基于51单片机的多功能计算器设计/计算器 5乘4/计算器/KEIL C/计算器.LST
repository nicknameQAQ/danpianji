  26          
  27          uchar code  welcome[]={"     welcome    "};     //显示缓存
  28          uchar code welcome2[]={"   calculator   "};
  29          
  30          void init()//显示和系统初始化函数
  31          {
  32   1              uchar i;
  33   1              EA=1;                           //开总中断
  34   1              ET1=1;                          //T1开
  35   1              TMOD=0X10;                      //设置T1工作方式1
  36   1              TH1=0X3C;TL1=0XB0;      //设置计数初置（晶振为12M，计50000个脉冲，50ms）
  37   1      
  38   1              P2_3=1;                         //背光灯控制引脚，默认开背光
  39   1              P3_6=0;                         //第二功能键指示灯
  40   1              lcd_init();                     //液晶显示初始化函数
  41   1              write_1602com(0x01);  //显示“welcom calaulator ”
  42   1              write_1602com(yh);
  43   1              for(i=0;i<16;i++)
  44   1              {
  45   2                      write_1602dat(welcome[i]);
  46   2                      delay(100);
  47   2              }
  48   1              write_1602com(er);
  49   1              for(i=0;i<16;i++)
  50   1              {
  51   2                      write_1602dat(welcome2[i]);
  52   2                      delay(100);
  53   2              }
  54   1              write_1602com(0x01);    //清屏
  55   1              write_1602com(0x80);    //显示指针初始化
