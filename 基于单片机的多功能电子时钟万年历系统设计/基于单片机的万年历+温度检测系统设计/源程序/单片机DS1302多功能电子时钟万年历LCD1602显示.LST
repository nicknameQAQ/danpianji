 623          /**************定时器0中断程序*****************/
 624          void time0() interrupt 1
 625          {                        
 626   1              static uchar value;
 627   1              TH0 = 0X3C;
 628   1              TL0 = 0XB0;        //50ms
 629   1              value ++;          
 630   1              if((value % 2) == 0)     //100ms  
 631   1                      flag_100ms = 1;  
 632   1              if(value >= 6)                   //200ms
 633   1              {
 634   2                      value = 0;
 635   2                      flag_200ms = 1;
 636   2              }
 637   1      }
