 118   1              write_18b20(0x44);         //启动一次温度转换命令
 119   1              delay_uint(50);            //500us
 120   1      
 121   1              init_18b20();              //初始化18b20
 122   1              
 123   1              write_18b20(0xcc);         //跳过64位ROM
 124   1              write_18b20(0xbe);         //发出读取暂存器命令
 125   1              
 126   1              EA = 0;
 127   1              low = read_18b20();        //读温度低字节
 128   1              value = read_18b20();  //读温度高字节
 129   1              EA = 1;
