 111          /*************读取温度的值 读出来的是小数***************/
 112          uint read_temp()
 113          {
 114   1              uint value;
 115   1              uchar low;                         //在读取温度的时候如果中断的太频繁了，就应该把中断给关了，否则会影响到18b20的时序
 116   1              init_18b20();              //初始化18b20
 117   1              write_18b20(0xcc);         //跳过64位ROM
