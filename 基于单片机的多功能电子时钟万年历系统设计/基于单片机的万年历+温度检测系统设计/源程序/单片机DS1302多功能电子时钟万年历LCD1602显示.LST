  66          /***********************18b20初始化函数*****************************/
  67          void init_18b20()
  68          {
  69   1              bit q;
  70   1              dq = 1;                         //把总线拿高
  71   1              delay_uint(1);      //15us
  72   1              dq = 0;                         //给复位脉冲
  73   1              delay_uint(80);         //750us
  74   1              dq = 1;                         //把总线拿高 等待
  75   1              delay_uint(10);         //110us
  76   1              q = dq;                         //读取18b20初始化信号
  77   1              delay_uint(20);         //200us
  78   1              dq = 1;                         //把总线拿高 释放总线
  79   1      }
  80          
  81          /*************写18b20内的数据***************/
  82          void write_18b20(uchar dat)
  83          {
  84   1              uchar i;
  85   1              for(i=0;i<8;i++)
  86   1              {                                        //写数据是低位开始
  87   2                      dq = 0;                  //把总线拿低写时间隙开始 
  88   2                      dq = dat & 0x01; //向18b20总线写数据了
  89   2                      delay_uint(5);   // 60us
  90   2                      dq = 1;                  //释放总线
  91   2                      dat >>= 1;
  92   2              }       
  93   1      }
  94          
  95          /*************读取18b20内的数据***************/
  96          uchar read_18b20()
  97          {
  98   1              uchar i,value;
  99   1              for(i=0;i<8;i++)
 100   1              {
 101   2                      dq = 0;                  //把总线拿低读时间隙开始 
 102   2                      value >>= 1;     //读数据是低位开始
 103   2                      dq = 1;                  //释放总线
 104   2                      if(dq == 1)              //开始读写数据 
 105   2                              value |= 0x80;
 106   2                      delay_uint(5);   //60us 读一个时间隙最少要保持60us的时间
 107   2              }
 108   1              return value;            //返回数据
 109   1      }
