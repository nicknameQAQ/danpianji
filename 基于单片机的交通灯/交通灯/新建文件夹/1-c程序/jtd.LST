 267          void display(void) //显示子程序
 268          {               
 269   1              buf[1]=sec_nb/10;               //第1位 东西秒十位
 270   1              buf[2]=sec_nb%10;               //第2位 东西秒个位
 271   1              buf[3]=sec_dx/10;               //第3位 南北秒十位
 272   1              buf[0]=sec_dx%10;               //第4位 南北秒个位              
 273   1              P1=0xff;                        // 初始灯为灭的
 274   1              P0=0x00;                                 ////灭显示
 275   1              P1=0xfe;                        //片选LED1
 276   1              P0=table[buf[1]];               //送东西时间十位的数码管编码                    
 277   1              delay(1);                               //延时
 278   1              P1=0xff;                                //关显示
 279   1              P0=0x00;                                //灭显示
 280   1                                                         
 281   1              P1=0xfd;                //片选LED2
 282   1              P0=table[buf[2]];                //送东西时间个位的数码管编码
 283   1              delay(1);                                //延时
 284   1              P1=0xff;                                //关显示
 285   1              P0=0x00;                                //关显示
 286   1      
 287   1              P1=0Xfb;                                //片选LED3
 288   1              P0=table[buf[3]];               //送南北时间十位的数码管编码
