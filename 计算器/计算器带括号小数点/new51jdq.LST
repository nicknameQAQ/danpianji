  75          /******************************************************************/
  76          /*检查LCD忙状态                                                   */
  77          /*LCD_check为1时，忙，等待。LCD_check为0时,闲，可写指令与数据。   */
  78          /******************************************************************/ 
  79          bit LCD_check()
  80          {                          
  81   1          bit result;
  82   1          LCD_RS=0;    //指令
  83   1          LCD_RW=1; //读
  84   1          LCD_EN=1; //允许读写
  85   1          delay_us(5); //等待，液晶显示器处理数据
  86   1          result=(bit)(P0&0x80) ;
  87   1          LCD_EN=0;//禁止读写
  88   1          return(result) ; 
  89   1      }
  90          /******************************************************************/ 
  91          /*写指令数据到LCD                                                 */
  92          /*RS=L，RW=L，E=高脉冲，D0-D7=指令码。                            */ 
  93          /******************************************************************/ 
  94          void LCD_write_com(unsigned char com)  
  95          {
  96   1              while(LCD_check());     //检查LCD忙状态
  97   1          LCD_RS=0;
  98   1          LCD_RW=0;
  99   1          LCD_EN=0;
 100   1              P0 = com;
 101   1              LCD_EN=1;
 102   1              delay_us(5);
 103   1              LCD_EN=0;
 104   1      }  
 105          /******************************************************************/ 
 106          /*写显示数据到LCD                                                  */
 107          /*RS=H，RW=L，E=高脉冲，D0-D7=数据。                               */ 
 108          /******************************************************************/ 
 109          void LCD_write_Data(unsigned char Data)  
 110          {
 111   1              while(LCD_check());
 112   1          LCD_RS=1;
 113   1          LCD_RW=0;
 114   1          LCD_EN=0;
 115   1              P0 = Data;
 116   1          LCD_EN=1;
 117   1              delay_us(5);
