 123          void LCD_write_str(unsigned char x,unsigned char y,unsigned char *s)  
 124          {
 125   1              unsigned char i,j;
 126   1              if (y == 0)
 127   1              {       LCD_write_com(0x80 + x);   }//写在液晶数据缓冲区第一行+x
 128   1          
 129   1              else
 130   1              {       LCD_write_com(0xC0 + x);   }//写在液晶数据缓冲区第二行+x
 131   1      
 132   1              for(i=4;i>0;i--)
 133   1              {
 134   2                      if(s[14] == '0' || s[14] == '.')
 135   2                      {
 136   3                              for(j=14;j>1;j--)
 137   3                              {       s[j] = s[j-1];  }
 138   3                      }
 139   2              else break;
 140   2              }
 141   1              while (*s) 
 142   1                      { 
 143   2                LCD_write_Data(*s);
 144   2                s++;
 145   2                      } 
 146   1      }  
