  41          /******************把数据保存到单片机内部eeprom中******************/
  42          void write_eeprom()
  43          {
  44   1              SectorErase(0x1000);
  45   1              GapValue1=GapValue&0x00ff;
  46   1              byte_write(0x2000, GapValue1);
  47   1              GapValue1=(GapValue&0xff00)>>8;
  48   1              byte_write(0x2001, GapValue1);
  49   1              byte_write(0x2060, a_a);        
  50   1      }
  51          
  52          /******************把数据从单片机内部eeprom中读出来*****************/
