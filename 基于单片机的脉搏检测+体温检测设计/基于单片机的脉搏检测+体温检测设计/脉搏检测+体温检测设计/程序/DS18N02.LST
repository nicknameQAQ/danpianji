  74          /*************************************************** 
  75                  DS18B20读温度程序
  76          ****************************************************/ 
  77          uint ReadTemperature() 
  78          { 
  79   1          uint temperature;
  80   1              Reset(); 
  81   1              WriteChar(0xcc); 
  82   1              WriteChar(0x44); 
  83   1              DDelay(125); 
  84   1              Reset();
  85   1              WriteChar(0xcc);
  86   1              WriteChar(0xbe);
