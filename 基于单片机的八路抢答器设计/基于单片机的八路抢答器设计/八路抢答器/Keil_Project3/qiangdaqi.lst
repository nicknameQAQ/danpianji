 155          /*---初始化定时器0---*/
 156          void InitTimer0(void)//50ms
 157          {
 158   1          TMOD = 0x01;//定时器工作模式1
 159   1          TH0 = 0x3C; //定时器装值高8位
 160   1          TL0 = 0x0B0;//定时器装值低8位
 161   1          EA = 1;             //使能总中断
 162   1          ET0 = 1;    //使能定时器0中断
 163   1          TR0 = 1;    //启动定时器
 164   1      }
 165          /*------关闭定时器0------*/
 166          void end_Timer0(void)
 167          {
 168   1              ET0 = 0;//关闭定时器0中断
 169   1          TR0 = 0;//停止定时器0
 170   1      }
 171          void Start_Timer0(void)
 172          {
 173   1              ET0 = 1;//启动定时器0中断
 174   1          TR0 = 1;//启动定时器0
 175   1      }
